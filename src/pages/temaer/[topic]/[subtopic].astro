---
import TopicPage from '@/components/pages/TopicPage.astro';
import { topics } from '@/data/topics';
import { episodesForSubtopic } from '@/lib/content';

/** Undertemaer med minst én oppføring. */
export async function getStaticPaths() {
  const paths = [];
  for (const topic of topics) {
    for (const sub of topic.subtopics) {
      const eps = await episodesForSubtopic('no', sub.id);
      if (eps.length > 0) {
        paths.push({ params: { topic: topic.id, subtopic: sub.id } });
      }
    }
  }
  return paths;
}

const { topic, subtopic } = Astro.params;
---

<TopicPage lang="no" topicId={topic!} subtopicId={subtopic!} />
