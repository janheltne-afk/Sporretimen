---
import ResourcePage from '@/components/pages/ResourcePage.astro';
import { getResources } from '@/lib/content';

export async function getStaticPaths() {
  const resources = await getResources('no');
  return resources.map((resource) => ({ params: { slug: resource.id }, props: { resource } }));
}

const { resource } = Astro.props;
---

<ResourcePage lang="no" resource={resource} />
