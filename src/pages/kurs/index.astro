---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Form from '@/components/Form.astro';
import { getCourses } from '@/lib/content';
import { courseStatuses } from '@/data/site';

const courses = await getCourses();
---

<BaseLayout
  title="Kurs"
  description="Det finnes utallige temaer det mangler kurs og god kunnskap om. Er interessen stor nok, bygger Spørretimen kurset. Se eksempler og meld interesse."
>
  <PageHeader
    eyebrow="Kurs"
    title="Kursene som ennå ikke finnes"
    lead="Det finnes ufattelig mange temaer det mangler kurs og god kunnskap om. Er interessen stor nok for et tema eller område, kan det bygges et kurs. Din interesse bestemmer hva som blir til."
  />

  <section class="section-tight">
    <div class="container">
      <div class="how card">
        <h2>Slik fungerer det</h2>
        <ol>
          <li><strong>Kunnskapen finnes – kursene mangler.</strong> Rundt oss finnes folk og miljøer med kompetanse det aldri er laget kurs om. Her samler vi ønskene.</li>
          <li><strong>Du melder interesse</strong> – for et av eksemplene under, eller foreslå et helt eget tema. Helt uforpliktende.</li>
          <li><strong>Blir interessen stor nok, bygges kurset.</strong> Temaene flest ønsker seg, blir til først – og du får beskjed når det er klart.</li>
        </ol>
      </div>

      {
        courses.length > 0 ? (
          <>
          <div class="grid-head">
            <h2>Eksempler på kurs som kan settes opp</h2>
            <p class="muted">
              Dette er ikke ferdige kurs, men eksempler på hva som kan bygges om
              mange nok er interessert. Meld interesse for dem du ville tatt.
            </p>
          </div>
          <div class="grid grid-3 course-grid">
            {courses.map((c) => {
              const st = courseStatuses[c.data.status];
              return (
                <article class="card course">
                  <a class="course__link" href={`/kurs/${c.id}`}>
                    <div class="course__body">
                      <span class:list={['tag', `cstatus-${c.data.status}`]}>{st.label}</span>
                      <h3 class="course__title">{c.data.title}</h3>
                      <p class="course__summary">{c.data.summary}</p>
                      {c.data.topics.length > 0 && (
                        <ul class="course__topics">
                          {c.data.topics.slice(0, 3).map((t) => (
                            <li>{t}</li>
                          ))}
                        </ul>
                      )}
                      <div class="course__foot">
                        {c.data.curriculum.length > 0 && (
                          <span class="course__parts">{c.data.curriculum.length} deler</span>
                        )}
                        <span class="course__cta">Meld interesse →</span>
                      </div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
          </>
        ) : (
          <p class="empty muted">
            Eksempler på mulige kurs legges ut her. Har du ønsker allerede nå?
            Bruk skjemaet under.
          </p>
        )
      }
    </div>
  </section>

  <section class="section general">
    <div class="container container-narrow">
      <div class="section-head">
        <h2>Hva mangler det kurs om?</h2>
        <p class="lead">
          Temaene over er bare eksempler. Savner du kunnskap om noe helt annet?
          Fortell oss hva du vil lære – er interessen stor nok, kan det bli et kurs
          av det.
        </p>
      </div>
      <Form
        formName="kursonske"
        subject="Kursønske – Spørretimen"
        submitLabel="Send kursønske"
        successMessage="Takk! Ønsket ditt er registrert og teller med i prioriteringen."
      >
        <div class="field--row">
          <div class="field">
            <label for="ko-navn">Navn <span class="req">*</span></label>
            <input id="ko-navn" name="Navn" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="ko-epost">E-post <span class="req">*</span></label>
            <input id="ko-epost" name="E-post" type="email" required autocomplete="email" />
          </div>
        </div>
        <div class="field">
          <label for="ko-tema">Hva vil du lære? <span class="req">*</span></label>
          <textarea id="ko-tema" name="Kursønske" required placeholder="Beskriv kort temaet eller kurset du ønsker deg."></textarea>
        </div>
      </Form>
    </div>
  </section>
</BaseLayout>

<style>
  .how {
    padding: 1.5rem 1.7rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.2rem);
    border-left: 4px solid var(--accent);
  }
  .how h2 {
    font-size: 1.25rem;
    margin: 0 0 0.7rem;
  }
  .how ol {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--ink-soft);
  }
  .how li {
    margin-bottom: 0.45rem;
  }
  .grid-head {
    margin-bottom: 1.2rem;
  }
  .grid-head h2 {
    font-size: 1.5rem;
    margin-bottom: 0.3rem;
  }
  .grid-head p {
    margin: 0;
    font-size: 0.95rem;
  }
  .course {
    overflow: hidden;
  }
  .course__link {
    display: flex;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .course__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.3rem 1.4rem 1.4rem;
    width: 100%;
  }
  .course__body .tag {
    align-self: flex-start;
  }
  .course__title {
    margin: 0.2rem 0 0;
    font-size: 1.3rem;
    line-height: 1.2;
  }
  .course__link:hover .course__title {
    color: var(--accent-strong);
  }
  .course__format {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .course__summary {
    margin: 0.1rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .course__topics {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .course__topics li {
    font-size: 0.76rem;
    color: var(--ink-soft);
    background: var(--surface-2);
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
  }
  .course__foot {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    border-top: 1px solid var(--line);
    margin-top: 1rem;
  }
  .course__parts {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .course__cta {
    color: var(--accent-strong);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .cstatus-vurderes {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .cstatus-planlagt {
    background: var(--tag-masterclass-bg);
    color: var(--tag-masterclass);
  }
  .cstatus-apen {
    background: var(--tag-samtale-bg);
    color: var(--tag-samtale);
  }
  .empty {
    padding: 2rem 1rem;
    text-align: center;
  }
  .general {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .req {
    color: var(--accent-strong);
  }
</style>
