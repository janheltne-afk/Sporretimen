---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/data/site';

const areas = [
  'Fremme en god sak eller et veldedig formål',
  'Kryssfremming med andre podkaster og skapere',
  'Festivaler og arrangementer',
  'Reiseliv og friluftsliv',
  'Utdanning og karriere',
  'Lokale artister og kulturmiljø',
];
---

<BaseLayout
  title="Samarbeid"
  description="Spørretimen er ikke en kommersiell podcast i dag. Samarbeid skjer på gøy, for å fremme podcasten eller en god sak. Betalte samarbeid kan bli aktuelt på sikt."
>
  <PageHeader
    eyebrow="Samarbeid"
    title="Samarbeid"
    lead="Spørretimen samarbeider gjerne med folk og miljøer som passer naturlig med podcastens profil – på ikke-kommersielt grunnlag."
  />

  <section class="section-tight">
    <div class="container container-narrow">
      <div class="card notice">
        <h2>Ikke en kommersiell podcast i dag</h2>
        <p>
          Spørretimen er et personlig prosjekt, ikke en kommersiell podcast. I dag
          inngår vi ikke betalte samarbeid eller sponsoravtaler. Samarbeid vi sier ja
          til, skjer på gøy, for å fremme podcasten, eller for å løfte en god sak.
        </p>
        <p class="notice__future">
          På sikt kan det åpne seg for betalte samarbeid – men det er altså ikke
          aktuelt nå.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Slik kan et samarbeid se ut i dag</h2>
        <p class="lead">
          Vi er åpne for uformelle, ikke-kommersielle samarbeid – så lenge de føles
          ekte for lytterne og passer inn i det redaksjonelle innholdet.
        </p>
      </div>
      <ul class="areas">
        {areas.map((a) => <li class="card area">{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="section principles-block">
    <div class="container container-narrow">
      <div class="card note-card">
        <h2>Redaksjonelle prinsipper</h2>
        <p>
          Det redaksjonelle innholdet styres av nysgjerrighet og gjestenes historier
          – ikke av kommersielle interesser. Skulle et samarbeid en gang innebære en
          motytelse, vil det alltid være tydelig merket, og vi skiller alltid klart
          mellom redaksjonelt innhold og eventuell annonsering.
        </p>
      </div>
    </div>
  </section>

  <section class="section future">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">På sikt</p>
        <h2>Muligheter hvis podcasten vokser</h2>
        <p class="lead">
          Podcasten bygges for å kunne utvikles til mer enn bare episoder. Dersom det
          en gang åpner seg for betalte samarbeid, kan de for eksempel knyttes til:
        </p>
      </div>
      <div class="grid grid-3">
        <div class="card future__card"><h3>Masterclass-arkiv</h3><p>Et betalingsbasert arkiv med lengre forklaringsepisoder.</p></div>
        <div class="card future__card"><h3>Nyhetsbrev og artikler</h3><p>Guider og fordypning knyttet til temaene i podcasten.</p></div>
        <div class="card future__card"><h3>Liveshow og arrangementer</h3><p>Liveopptak, festivalintervjuer og publikumsspørsmål.</p></div>
        <div class="card future__card"><h3>Temaserier</h3><p>Sammenhengende serier rundt yrker, bransjer eller fagfelt.</p></div>
        <div class="card future__card"><h3>Kurs og foredrag</h3><p>Samarbeid med utdanningsinstitusjoner og bedrifter.</p></div>
        <div class="card future__card"><h3>Medlemsinnhold</h3><p>Ekstra innhold for lyttere som ønsker å støtte podcasten.</p></div>
      </div>
    </div>
  </section>

  <section class="section cta-block">
    <div class="container container-narrow text-center">
      <h2>Vil du samarbeide med Spørretimen?</h2>
      <p class="lead mx-auto">
        Ta kontakt for en uforpliktende prat om hvordan et samarbeid kan se ut.
      </p>
      <div class="cta-block__actions">
        <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent('Samarbeid – Spørretimen')}`}>Ta kontakt om samarbeid</a>
        <a class="btn btn-secondary" href="/kontakt">Til kontaktsiden</a>
      </div>
      <p class="muted disclaimer">
        Spørretimen er ikke en kommersiell podcast i dag, og det finnes ingen
        inngåtte sponsor- eller betalingsavtaler. Denne siden beskriver hvordan
        ikke-kommersielle samarbeid kan se ut, og hva som kan bli mulig på sikt.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 0.8rem;
  }
  .area {
    padding: 1rem 1.2rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .notice {
    padding: 1.6rem 1.8rem;
    border-left: 4px solid var(--accent);
    background: var(--accent-soft);
  }
  .notice h2 {
    margin-top: 0;
    font-size: 1.3rem;
  }
  .notice p {
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
  .notice__future {
    margin-bottom: 0;
    font-weight: 600;
    color: var(--ink);
  }
  .principles-block {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .note-card {
    padding: 1.8rem;
    border-left: 4px solid var(--accent);
  }
  .note-card h2 {
    margin-top: 0;
  }
  .note-card p {
    color: var(--ink-soft);
    margin: 0;
  }
  .future__card {
    padding: 1.4rem 1.5rem;
  }
  .future__card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.15rem;
  }
  .future__card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }
  .cta-block {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .cta-block__actions {
    display: flex;
    gap: 0.7rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .disclaimer {
    margin-top: 1.6rem;
    font-size: 0.85rem;
  }
</style>
