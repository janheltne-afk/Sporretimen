---
/**
 * Redaksjonelt samarbeid.
 *
 * Siden handler om innhold: gjester, temaer, deltakelse i episoder og
 * samarbeid med andre podkaster. Den beskriver ikke tjenester, tilbud eller
 * planer om inntekt – Spørretimen er et fritidsprosjekt, og siden skal lese
 * som det.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/data/site';

const areas = [
  {
    title: 'Foreslå en gjest eller et tema',
    body: 'Kjenner du noen med en historie, et yrke eller en kunnskap flere burde få høre om? Det er den vanligste og mest nyttige måten å bidra.',
  },
  {
    title: 'Være med i en episode',
    body: 'Som gjest i en samtale, eller som fagperson som leser gjennom en forklaring før den spilles inn.',
  },
  {
    title: 'Samarbeid mellom podkaster',
    body: 'Gjestebytte, felles episoder eller å tipse hverandres lyttere om noe de vil ha glede av.',
  },
  {
    title: 'Kunnskapsdeling',
    body: 'Å peke på gode kilder, rette opp noe som er upresist, eller foreslå litteratur til et tema som skal dekkes.',
  },
  {
    title: 'Redaksjonelle prosjekter',
    body: 'Temaserier, opptak fra et arrangement eller episoder laget rundt et fagmiljø.',
  },
  {
    title: 'Fagmiljøer og foreninger',
    body: 'Lag, foreninger og fagmiljøer som har noe å forklare, og gjerne vil ha det forklart ordentlig.',
  },
];
---

<BaseLayout
  title="Samarbeid"
  description="Spørretimen er et hobbyprosjekt. Siden beskriver redaksjonelt samarbeid – gjesteforslag, temaer, deltakelse i episoder og samarbeid med andre podkaster."
>
  <PageHeader
    eyebrow="Samarbeid"
    title="Redaksjonelt samarbeid"
    lead="Spørretimen lages av nysgjerrighet, og blir bedre av innspill. Her er måtene det er nyttig å bidra på."
  />

  <section class="section-tight">
    <div class="container container-narrow">
      <div class="card notice">
        <h2>Et hobbyprosjekt</h2>
        <p>
          Spørretimen er en hobby, og lages på fritiden – fordi det er gøy å lære noe
          nytt, og fordi folk sitter på historier som fortjener flere lyttere. Det er
          ingenting til salgs her, og ingen sponsorer.
        </p>
        <p>
          Samarbeid betyr derfor én ting: innhold. Gode gjester, gode temaer og folk
          som kan rette opp noe vi har misforstått. Det er den morsomste delen av å
          lage dette.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Måter å bidra</h2>
        <p class="lead">
          Det meste av dette koster ingenting annet enn en e-post, og flere av
          episodene har blitt til nettopp slik.
        </p>
      </div>
      <ul class="areas">
        {
          areas.map((a) => (
            <li class="card area">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section principles-block">
    <div class="container container-narrow">
      <div class="card note-card">
        <h2>Redaksjonelle prinsipper</h2>
        <p>
          Innholdet styres av nysgjerrighet og av gjestenes historier. Ingen får
          betalt for å delta, og ingen betaler for å bli omtalt. Skulle det en gang
          foreligge en avtale som innebærer en motytelse, blir den merket tydelig –
          se <a href="/redaksjonelle-prinsipper/">redaksjonelle prinsipper</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section cta-block">
    <div class="container container-narrow text-center">
      <h2>Har du et forslag?</h2>
      <p class="lead mx-auto">
        Send en e-post, eller bruk skjemaet for gjesteforslag hvis du har noen i
        tankene.
      </p>
      <div class="cta-block__actions">
        <a class="btn" href="/foresla-gjest/">Foreslå en gjest</a>
        <a class="btn btn-secondary" href={`mailto:${site.email}?subject=${encodeURIComponent('Innspill til Spørretimen')}`}>
          Send en e-post
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0.9rem;
  }
  .area {
    padding: 1.4rem 1.5rem;
  }
  .area h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
  .area p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }
  .notice {
    padding: 1.6rem 1.8rem;
    border-left: 4px solid var(--accent);
    background: var(--accent-soft);
  }
  .notice h2 {
    margin-top: 0;
    font-size: 1.3rem;
  }
  .notice p {
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
  .notice p:last-child {
    margin-bottom: 0;
  }
  .principles-block {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .note-card {
    padding: 1.8rem;
    border-left: 4px solid var(--accent);
  }
  .note-card h2 {
    margin-top: 0;
  }
  .note-card p {
    color: var(--ink-soft);
    margin: 0;
  }
  .cta-block {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .cta-block__actions {
    display: flex;
    gap: 0.7rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
