---
import DeckPage from '@/components/pages/DeckPage.astro';
import { getEpisodes, slugOf } from '@/lib/content';

export async function getStaticPaths() {
  const episodes = await getEpisodes('en');
  return episodes.map((episode) => ({ params: { slug: slugOf(episode.id) }, props: { episode } }));
}

const { episode } = Astro.props;
---

<DeckPage lang="en" episode={episode} />
