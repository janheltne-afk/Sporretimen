---
import TranscriptPage from '@/components/pages/TranscriptPage.astro';
import { getScripts, slugOf } from '@/lib/content';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  const scripts = await getScripts('en');
  return Promise.all(
    scripts.map(async (script) => {
      const episode = await getEntry(script.data.episode);
      return { params: { slug: slugOf(episode!.id) }, props: { script, episode } };
    })
  );
}

const { script, episode } = Astro.props;
---

<TranscriptPage lang="en" script={script} episode={episode} />
