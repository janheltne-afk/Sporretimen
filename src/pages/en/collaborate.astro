---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/data/site';
import { path } from '@/i18n/config';

const areas = [
  'Supporting a good cause or a charity',
  'Cross-promotion with other podcasts and creators',
  'Festivals and events',
  'Travel and the outdoors',
  'Education and careers',
  'Local artists and cultural life',
];
---

<BaseLayout
  lang="en"
  title="Collaborate"
  description="Spørretimen is not a commercial podcast today. Collaborations happen for the fun of it, to promote the podcast, or to support a good cause. Paid collaborations may become relevant in time."
>
  <PageHeader
    eyebrow="Collaborate"
    title="Collaborate"
    lead="Spørretimen is glad to work with people and communities that fit the podcast naturally – on a non-commercial basis."
  />

  <section class="section-tight">
    <div class="container container-narrow">
      <div class="card notice">
        <h2>Not a commercial podcast today</h2>
        <p>
          Spørretimen is a personal project, not a commercial podcast. We do not
          currently enter paid collaborations or sponsorship deals. The
          collaborations we do say yes to happen for the fun of it, to promote the
          podcast, or to lift a good cause.
        </p>
        <p class="notice__future">
          Paid collaborations may open up in time – but that is not the case now.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>What a collaboration can look like today</h2>
        <p class="lead">
          We are open to informal, non-commercial collaborations – as long as they
          feel genuine to listeners and fit the editorial content.
        </p>
      </div>
      <ul class="areas">
        {areas.map((a) => <li class="card area">{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="section principles-block">
    <div class="container container-narrow">
      <div class="card note-card">
        <h2>Editorial principles</h2>
        <p>
          The editorial content is driven by curiosity and by the guests’ stories –
          not by commercial interests. Should a collaboration ever involve something
          in return, it will always be clearly marked, and we always keep editorial
          content and any advertising distinctly apart.
        </p>
      </div>
    </div>
  </section>

  <section class="section future">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">In time</p>
        <h2>Possibilities if the podcast grows</h2>
        <p class="lead">
          The podcast is built so it can become more than episodes. If paid
          collaborations ever open up, they could for instance attach to:
        </p>
      </div>
      <div class="grid grid-3">
        <div class="card future__card"><h3>Explainer archive</h3><p>A paid archive of longer explainer episodes.</p></div>
        <div class="card future__card"><h3>Newsletter and articles</h3><p>Guides and depth around the subjects in the podcast.</p></div>
        <div class="card future__card"><h3>Live shows and events</h3><p>Live recordings, festival interviews and audience questions.</p></div>
        <div class="card future__card"><h3>Themed series</h3><p>Connected series around professions, industries or fields.</p></div>
        <div class="card future__card"><h3>Courses and talks</h3><p>Working with educational institutions and companies.</p></div>
        <div class="card future__card"><h3>Member content</h3><p>Extra material for listeners who want to support the podcast.</p></div>
      </div>
    </div>
  </section>

  <section class="section cta-block">
    <div class="container container-narrow text-center">
      <h2>Would you like to work with Spørretimen?</h2>
      <p class="lead mx-auto">
        Get in touch for an informal chat about what a collaboration could look like.
      </p>
      <div class="cta-block__actions">
        <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent('Collaboration – Spørretimen')}`}>
          Get in touch about collaborating
        </a>
        <a class="btn btn-secondary" href={path('en', 'contact')}>To the contact page</a>
      </div>
      <p class="muted disclaimer">
        Spørretimen is not a commercial podcast today, and there are no sponsorship
        or payment agreements in place. This page describes what non-commercial
        collaborations can look like, and what may become possible in time.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 0.8rem;
  }
  .area {
    padding: 1rem 1.2rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .notice {
    padding: 1.6rem 1.8rem;
    border-left: 4px solid var(--accent);
    background: var(--accent-soft);
  }
  .notice h2 {
    margin-top: 0;
    font-size: 1.3rem;
  }
  .notice p {
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
  .notice__future {
    margin-bottom: 0;
    font-weight: 600;
    color: var(--ink);
  }
  .principles-block {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .note-card {
    padding: 1.8rem;
    border-left: 4px solid var(--accent);
  }
  .note-card h2 {
    margin-top: 0;
  }
  .note-card p {
    color: var(--ink-soft);
    margin: 0;
  }
  .future__card {
    padding: 1.4rem 1.5rem;
  }
  .future__card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.15rem;
  }
  .future__card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }
  .cta-block {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .cta-block__actions {
    display: flex;
    gap: 0.7rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .disclaimer {
    margin-top: 1.6rem;
    font-size: 0.85rem;
  }
</style>
