---
/**
 * Editorial collaboration. Norwegian original in src/pages/samarbeid.astro.
 *
 * The page is about content: guests, subjects, taking part in episodes and
 * working with other podcasts. It does not describe services, offerings or
 * plans for revenue – Spørretimen is a spare-time project, and the page should
 * read like one.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/data/site';
import { path } from '@/i18n/config';

const areas = [
  {
    title: 'Suggest a guest or a subject',
    body: 'Do you know someone with a story, a profession or knowledge more people ought to hear about? That is the most common and most useful way to contribute.',
  },
  {
    title: 'Take part in an episode',
    body: 'As a guest in a conversation, or as a specialist reading through an explainer before it is recorded.',
  },
  {
    title: 'Podcast to podcast',
    body: 'Swapping guests, joint episodes, or pointing each other’s listeners at something they will enjoy.',
  },
  {
    title: 'Sharing knowledge',
    body: 'Pointing to good sources, correcting something imprecise, or suggesting reading for a subject that is coming up.',
  },
  {
    title: 'Editorial projects',
    body: 'Themed series, recordings from an event, or episodes built around a particular field.',
  },
  {
    title: 'Professional bodies and societies',
    body: 'Associations and professional communities that have something to explain, and would like it explained properly.',
  },
];
---

<BaseLayout
  lang="en"
  title="Collaborate"
  description="Spørretimen is a private spare-time project. This page describes editorial collaboration – guest suggestions, subjects, taking part in episodes and working with other podcasts."
>
  <PageHeader
    eyebrow="Collaborate"
    title="Editorial collaboration"
    lead="Spørretimen is made out of curiosity, and gets better from input. Here are the ways it helps to contribute."
  />

  <section class="section-tight">
    <div class="container container-narrow">
      <div class="card notice">
        <h2>What Spørretimen is</h2>
        <p>
          Spørretimen is currently a private, non-commercial spare-time project and
          does not offer paid services. There are no sponsorship deals, no
          advertising and nothing for sale.
        </p>
        <p>
          Collaboration here therefore means one thing: content. Good guests, good
          subjects, and people who can correct something we have misunderstood.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Ways to contribute</h2>
        <p class="lead">
          Most of this costs nothing but an email, and several of the episodes came
          about exactly that way.
        </p>
      </div>
      <ul class="areas">
        {
          areas.map((a) => (
            <li class="card area">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section principles-block">
    <div class="container container-narrow">
      <div class="card note-card">
        <h2>Editorial principles</h2>
        <p>
          The content is driven by curiosity and by the guests’ stories. Nobody is
          paid to take part, and nobody pays to be covered. Should there ever be an
          arrangement involving something in return, it will be clearly marked – see
          <a href={path('en', 'principles')}>editorial principles</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section cta-block">
    <div class="container container-narrow text-center">
      <h2>Have a suggestion?</h2>
      <p class="lead mx-auto">
        Send an email, or use the guest suggestion form if you have someone in mind.
      </p>
      <div class="cta-block__actions">
        <a class="btn" href={path('en', 'suggestGuest')}>Suggest a guest</a>
        <a class="btn btn-secondary" href={`mailto:${site.email}?subject=${encodeURIComponent('Input for Spørretimen')}`}>
          Send an email
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0.9rem;
  }
  .area {
    padding: 1.4rem 1.5rem;
  }
  .area h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
  .area p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }
  .notice {
    padding: 1.6rem 1.8rem;
    border-left: 4px solid var(--accent);
    background: var(--accent-soft);
  }
  .notice h2 {
    margin-top: 0;
    font-size: 1.3rem;
  }
  .notice p {
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
  .notice p:last-child {
    margin-bottom: 0;
  }
  .principles-block {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .note-card {
    padding: 1.8rem;
    border-left: 4px solid var(--accent);
  }
  .note-card h2 {
    margin-top: 0;
  }
  .note-card p {
    color: var(--ink-soft);
    margin: 0;
  }
  .cta-block {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .cta-block__actions {
    display: flex;
    gap: 0.7rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
