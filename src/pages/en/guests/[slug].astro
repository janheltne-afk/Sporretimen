---
import GuestPage from '@/components/pages/GuestPage.astro';
import { getGuests, getEpisodes, episodesForGuest, getScripts, slugOf } from '@/lib/content';

export async function getStaticPaths() {
  const guests = await getGuests('en');
  const episodes = await getEpisodes('en');
  const scriptEpisodeIds = (await getScripts()).map((s) => s.data.episode.id);
  return Promise.all(
    guests.map(async (guest) => ({
      params: { slug: slugOf(guest.id) },
      props: { guest, episodes: await episodesForGuest(guest.id, episodes), scriptEpisodeIds },
    }))
  );
}

const { guest, episodes, scriptEpisodeIds } = Astro.props;
---

<GuestPage lang="en" guest={guest} episodes={episodes} scriptEpisodeIds={scriptEpisodeIds} />
