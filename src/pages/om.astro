---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Avatar from '@/components/Avatar.astro';
import { site } from '@/data/site';
import { entryPath, path as routePath } from '@/i18n/config';

// Mastergraden har sin egen episode. Den som lurer på hva den handlet om, skal
// kunne trykke seg dit herfra.
---

<BaseLayout
  title="Om Spørretimen"
  description="Hvorfor Spørretimen ble startet, hva konseptet er, og hvem Jan Sindre Heltne er."
>
  <PageHeader
    eyebrow="Om Spørretimen"
    title="Menneskene, yrkene og historiene du vil forstå bedre"
    lead="En podcast for deg som er nysgjerrig på hvordan ting egentlig fungerer."
  />

  <section class="section">
    <div class="container container-narrow prose">
      <p>
        Spørretimen ble startet med en enkel idé: Mange mennesker sitter på
        historier, erfaringer og kunnskap som flere burde få høre.
      </p>
      <p>
        Gjennom personlige samtaler møter Jan Sindre mennesker fra ulike yrker,
        miljøer og bakgrunner. Noen episoder handler om karriere og arbeidsliv.
        Andre handler om ekspedisjoner, helse, økonomi, musikk, teknologi eller
        opplevelser som har formet gjestene.
      </p>

      <h2>Et sentralt spørsmål</h2>
      <p>
        Et spørsmål går igjen i mange av intervjuene:
        <em>Hvordan er det egentlig å jobbe med dette?</em> Gjennom gjestenes
        historier fungerer podcasten også som en slags karrierepodcast, der du får
        innsikt i ulike yrker, utdanningsvalg, arbeidsdager, utfordringer,
        muligheter og veier inn i forskjellige bransjer.
      </p>
    </div>
  </section>

  <section class="section host">
    <div class="container host__inner">
      <div class="host__portrait">
        <Avatar
          name={site.host}
          src={site.hostImage}
          alt={`${site.host}, programleder i Spørretimen`}
          ratio="1 / 1"
        />
      </div>
      <div class="host__text">
        <p class="eyebrow">Programleder</p>
        <h2>{site.host}</h2>
        <p class="lead">
          Jan Sindre er siviløkonom med master i logistikk, og
          har bakgrunn fra ERP. Han er nysgjerrig, relasjonsorientert og liker å møte
          mennesker med andre erfaringer og fagområder enn ham selv.
        </p>
        <p class="host__note">
          Til daglig jobber Jan Sindre med Business Analytics. Spørretimen er hobbyen:
          noe han lager på fritiden fordi han liker å grave i ting og snakke med folk
          som kan noe.
          Skulle en episode en gang ha en jobbsammenheng, blir det tydelig merket og
          forklart i episoden. I all hovedsak er dette et personlig hobbyprosjekt.
        </p>
      </div>
    </div>
  </section>

  <section class="section geo">
    <div class="container container-narrow text-center">
      <p class="eyebrow">Hvor vi holder til</p>
      <h2>Forankret på Sunnmøre – reiser gjerne</h2>
      <p class="lead mx-auto">
        Spørretimen har en naturlig tilknytning til Sunnmøre. Men podcasten er ikke
        begrenset geografisk: er det noen spennende å snakke med, reiser vi gjerne
        dit de er. Målet er gjester fra hele Norge.
      </p>
      <div class="geo__actions">
        <a class="btn" href="/episoder/">Se episodene</a>
        <a class="btn btn-secondary" href="/bli-gjest/">Bli gjest</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .host__inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
  }
  .host__portrait {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 280px;
  }
  .host__note {
    margin-top: 1.1rem;
    padding: 1rem 1.2rem;
    background: var(--surface-2);
    border-radius: var(--radius);
    border-left: 3px solid var(--accent);
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .geo__actions {
    display: flex;
    gap: 0.7rem;
    justify-content: center;
    margin-top: 1.6rem;
    flex-wrap: wrap;
  }
  @media (max-width: 760px) {
    .host__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
