---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Siden finnes ikke" noindex>
  <section class="section notfound">
    <div class="container container-narrow text-center">
      <p class="big">?</p>
      <h1>Denne siden fant vi ikke</h1>
      <p class="lead mx-auto">
        Kanskje lenken er utdatert, eller så er innholdet flyttet. Prøv en av veiene
        under.
      </p>
      <div class="notfound__actions">
        <a class="btn" href="/">Til forsiden</a>
        <a class="btn btn-secondary" href="/episoder">Se episoder</a>
        <a class="btn btn-ghost" href="/kontakt">Kontakt oss →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(3rem, 10vw, 7rem);
  }
  .big {
    font-family: var(--font-display);
    font-size: clamp(5rem, 18vw, 10rem);
    line-height: 1;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  .notfound__actions {
    display: flex;
    gap: 0.7rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.6rem;
  }
</style>
