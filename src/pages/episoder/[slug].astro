---
import EpisodePage from '@/components/pages/EpisodePage.astro';
import { getEpisodes } from '@/lib/content';

export async function getStaticPaths() {
  const episodes = await getEpisodes('no');
  return episodes.map((episode) => ({ params: { slug: episode.id }, props: { episode } }));
}

const { episode } = Astro.props;
---

<EpisodePage lang="no" episode={episode} />
