---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import { htmlLang, localeFromUrl, searchKindOf, type Locale } from '@/i18n/config';

interface Props {
  /** Språket siden vises på. Utledes fra adressen hvis den ikke settes. */
  lang?: Locale;
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  /**
   * Sider som fyller skjermen selv, uten sidehode og bunntekst – i praksis
   * presentasjonsutgaven av en episode. Skriftene, temaet og SEO-hodet er det
   * samme, bare rammen rundt er borte.
   */
  bare?: boolean;
  /**
   * Settes på sider som ikke finnes på det andre språket (foreløpig manusene).
   * Da vises verken språkknapp eller hreflang, siden begge ville pekt på 404.
   */
  noAlternate?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
const lang: Locale = props.lang ?? localeFromUrl(Astro.url);

/**
 * Nøkkelen søkeindeksen grupperer etter. Den legges ut i HTML-en fordi
 * indeksen bygges av de ferdige sidene i dist/ – da slipper indekseringen å
 * gjette seksjon ut fra adressen, og den kan ikke komme i utakt med rutene.
 * Sider som ikke skal kunne søkes opp, er de samme som ikke skal indekseres.
 */
const searchKind = props.noindex ? undefined : searchKindOf(lang, Astro.url.pathname);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f3ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12100d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Skriftene er selvhostet. De to som alltid brukes lastes tidlig. -->
    <link
      rel="preload"
      href="/fonts/newsreader-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} – ${lang === 'en' ? 'episodes' : 'episoder'}`}
      href="/rss.xml"
    />
    <SEO {...props} lang={lang} />
    <!-- Sett tema før maling for å unngå flimmer -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('sporretimen-theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {
      props.bare ? (
        <main id="main" data-search-kind={searchKind}>
          <slot />
        </main>
      ) : (
        <>
          <a class="skip-link" href="#main">
            {lang === 'en' ? 'Skip to content' : 'Hopp til innhold'}
          </a>
          <Header lang={lang} noAlternate={props.noAlternate} />
          <main id="main" data-search-kind={searchKind}>
            <slot />
          </main>
          <Footer lang={lang} />
        </>
      )
    }

    <script>
      import { bindTrackedElements, track } from '@/lib/analytics';

      // Alt som er merket med data-track kobles opp ett sted.
      bindTrackedElements();
      // Én sidevisning, med konteksten siden har lagt ut i data-content-meta.
      const meta = document.querySelector<HTMLElement>('[data-content-meta]');
      track('content_view', { ...(meta?.dataset ?? {}) });
    </script>

    <script>
      // Diskret innfelling ved scroll
      const els = document.querySelectorAll('.reveal');
      if (els.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
