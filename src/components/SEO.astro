---
import { site, socials, canonicalUrl, absoluteUrl } from '@/data/site';
import { alternatePath, englishReady, htmlLang, ogLocale, path, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang?: Locale;
  title?: string;
  description?: string;
  /** Sti til delingsbilde (valgfritt). */
  image?: string;
  /** Alt-tekst for delingsbildet. */
  imageAlt?: string;
  /** 'website' | 'article' */
  type?: string;
  noindex?: boolean;
  /** Sider uten motstykke på det andre språket får ingen hreflang. */
  noAlternate?: boolean;
  /** Ekstra JSON-LD-objekt(er) som legges inn i <head>. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  lang = 'no',
  title,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  noAlternate = false,
  jsonLd,
} = Astro.props;

const t = useTranslations(lang);
const tagline = t('site.tagline');
const description = Astro.props.description ?? t('site.description');

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} – ${tagline}`;
const canonical = canonicalUrl(Astro.url.pathname);
const ogImage = absoluteUrl(image ?? site.ogImage);
const ogImageAlt = imageAlt ?? title ?? `${site.name} – ${tagline}`;

// Samme side på det andre språket. Uten hreflang vet ikke søkemotorene at de
// to versjonene hører sammen, og risikoen er at de leses som duplikater.
const alternate = canonicalUrl(alternatePath(lang, Astro.url.pathname));

// Lenker til offisielle profiler (sameAs).
const sameAs = socials.map((s) => s.url).filter((u): u is string => Boolean(u));

// Programlederen som Person – gjenbrukes som author/founder.
const host = {
  '@type': 'Person',
  name: site.host,
  jobTitle: lang === 'en' ? 'Host' : 'Programleder',
  url: canonicalUrl(path(lang, 'about')),
};

// Organisasjonen bak podkasten.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: canonicalUrl(path(lang, 'home')),
  logo: absoluteUrl('/favicon.svg'),
  description,
  founder: host,
  ...(sameAs.length ? { sameAs } : {}),
};

// Selve podkast-serien.
const podcastSeries = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: site.name,
  url: canonicalUrl(path(lang, 'home')),
  description,
  inLanguage: lang === 'en' ? 'en' : 'nb-NO',
  author: host,
  ...(sameAs.length ? { sameAs } : {}),
};

const base = [organization, podcastSeries];
const structured = jsonLd ? [...base, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : base;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  /* hreflang skal bare peke på sider som faktisk finnes. Peker den på en
     adresse som gir 404, er den verre enn ingen hreflang. */
  englishReady && !noAlternate && (
    <>
      <link rel="alternate" hreflang={htmlLang.no} href={canonicalUrl(lang === 'no' ? Astro.url.pathname : alternate)} />
      <link rel="alternate" hreflang={htmlLang.en} href={canonicalUrl(lang === 'en' ? Astro.url.pathname : alternate)} />
      <link rel="alternate" hreflang="x-default" href={canonicalUrl(lang === 'no' ? Astro.url.pathname : alternate)} />
    </>
  )
}
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}
<meta name="author" content={site.host} />

<!-- Open Graph -->
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title ?? `${site.name} – ${tagline}`} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[lang]} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Twitter/X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? site.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{structured.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
