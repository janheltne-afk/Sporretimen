---
/**
 * Interaktive regnestykker i artikkeltekst.
 *
 * Selve skjemaet står i Markdown-fila, som all annen figurmarkering på
 * nettstedet. Denne komponenten legger på utseendet og regnestykket, og
 * kobles på episoder som har `calculator:` i frontmatter.
 *
 * Uten JavaScript står feltene igjen med sine egne verdier, og de utregnede
 * tallene er de samme som i artikkelens eget eksempel. Da er blokka en
 * oppslagstabell i stedet for et verktøy – ingenting som betyr noe, faller
 * bort.
 */
import { type Locale } from '@/i18n/config';

interface Props {
  type: 'teu' | 'mrp' | 'eoq';
  lang?: Locale;
}
const { type, lang = 'no' } = Astro.props;
const en = lang === 'en';
---

{type === 'teu' && (
<script
    is:inline
    data-locale={en ? 'en-GB' : 'nb-NO'}
    data-ship={en
      ? 'A ship rated at {teu} TEU carries roughly {boxes} boxes with this mix.'
      : 'Et skip på {teu} TEU tar omtrent {boxes} bokser med denne blandingen.'}
    data-empty={en
      ? 'Enter a number of containers to see the total.'
      : 'Fyll inn et antall containere for å se summen.'}
  >
    (() => {
      // Må leses med én gang: currentScript er bare satt mens skriptet kjører.
      const cfg = document.currentScript;
      const locale = cfg.dataset.locale;
      const malSkip = cfg.dataset.ship;
      const malTom = cfg.dataset.empty;
      const tall = (n, des = 0) =>
        n.toLocaleString(locale, { minimumFractionDigits: des, maximumFractionDigits: des });
  
      const start = () => {
        document.querySelectorAll('[data-kalkulator="teu"]').forEach((form) => {
          const inn = [...form.querySelectorAll('[data-teu]')];
          const skip = form.querySelector('[data-skip]');
          const ut = (navn) => form.querySelector('[data-ut="' + navn + '"]');
          if (!inn.length || !ut('teu')) return;
  
          const regn = () => {
            let teu = 0;
            let bokser = 0;
            inn.forEach((el) => {
              // Negative og ugyldige verdier teller som null, ikke som feil.
              const antall = Math.max(0, Math.floor(Number(el.value) || 0));
              teu += antall * Number(el.dataset.teu);
              bokser += antall;
            });
  
            ut('teu').textContent = tall(teu);
            ut('bokser').textContent = tall(bokser);
            // Snittet er leddet som gjør et TEU-tall om til et antall bokser.
            ut('snitt').textContent = bokser ? tall(teu / bokser, 2) : '–';
  
            const melding = ut('melding');
            if (!melding) return;
            const kapasitet = Math.max(0, Math.floor(Number(skip && skip.value) || 0));
            melding.textContent =
              bokser && kapasitet
                ? malSkip
                    .replace('{teu}', tall(kapasitet))
                    .replace('{boxes}', tall(Math.floor(kapasitet / (teu / bokser))))
                : malTom;
          };
  
          [...inn, skip].filter(Boolean).forEach((el) => el.addEventListener('input', regn));
          form.addEventListener('submit', (e) => e.preventDefault());
          form.dataset.live = 'ja';
          regn();
        });
      };
  
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
)}

{type === 'mrp' && (
<script
    is:inline
    data-locale={en ? 'en-GB' : 'nb-NO'}
    data-decided={en
      ? 'A delivery in week {uke} is in practice decided in week {tidligst} – {diff} weeks earlier.'
      : 'En leveranse i uke {uke} er i praksis besluttet i uke {tidligst} – {diff} uker før.'}
    data-decided-one={en
      ? 'A delivery in week {uke} is in practice decided in week {tidligst} – one week earlier.'
      : 'En leveranse i uke {uke} er i praksis besluttet i uke {tidligst} – én uke før.'}
    data-impossible={en
      ? 'With these numbers the first order falls in week {tidligst}, before the plan begins. Delivery in week {uke} is not possible.'
      : 'Med disse tallene faller den første bestillingen i uke {tidligst}, før planen begynner. Levering i uke {uke} er ikke mulig.'}
    data-nothing={en
      ? 'Enter a number of shelves to plan a run.'
      : 'Fyll inn et antall hyller for å planlegge en kjøring.'}
    data-covered={en
      ? 'Stock covers the whole order. Nothing needs to be made or bought.'
      : 'Lageret dekker hele ordren. Ingenting må lages eller kjøpes.'}
  >
    (() => {
      const cfg = document.currentScript;
      const locale = cfg.dataset.locale;
      const mal = {
        decided: cfg.dataset.decided,
        decidedOne: cfg.dataset.decidedOne,
        impossible: cfg.dataset.impossible,
        nothing: cfg.dataset.nothing,
        covered: cfg.dataset.covered,
      };
      const tall = (n) => n.toLocaleString(locale);
  
      /* Stykklista fra artikkelen. `per` er antall per enhet av forelderen,
         `ledetid` er uker. Rekkefølgen er nivå for nivå ovenfra: en del kan
         bare regnes ut etter at forelderen er ferdig. */
      const deler = [
        { id: 'bokhylle', per: 1, ledetid: 1, forelder: null },
        { id: 'sidevange', per: 2, ledetid: 2, forelder: 'bokhylle' },
        { id: 'plate', per: 1, ledetid: 3, forelder: 'sidevange' },
        { id: 'hyllebord', per: 4, ledetid: 2, forelder: 'bokhylle' },
        { id: 'skrue', per: 24, ledetid: 1, forelder: 'bokhylle' },
      ];
  
      const start = () => {
        document.querySelectorAll('[data-kalkulator="mrp"]').forEach((form) => {
          const felt = (navn) => form.querySelector('[data-mrp="' + navn + '"]');
          const ut = (navn) => form.querySelector('[data-ut="' + navn + '"]');
          const inn = [...form.querySelectorAll('[data-mrp], [data-lager]')];
          if (!inn.length || !ut('bokhylle-netto')) return;
  
          const heltall = (el, minst) => {
            const v = Math.floor(Number(el && el.value) || 0);
            return Math.max(minst, v);
          };
  
          const regn = () => {
            const antall = heltall(felt('antall'), 0);
            const leveringsuke = heltall(felt('uke'), 1);
            const rad = {};
  
            deler.forEach((del) => {
              const forelder = del.forelder ? rad[del.forelder] : null;
              /* Nettingen er poenget: barnet regnes ut fra forelderens NETTO,
                 ikke brutto. Det forelderen allerede har på lager, inneholder
                 jo delene sine fra før. */
              const brutto = forelder ? forelder.netto * del.per : antall * del.per;
              const lagerfelt = form.querySelector('[data-lager="' + del.id + '"]');
              const lager = lagerfelt ? heltall(lagerfelt, 0) : 0;
              const netto = Math.max(0, brutto - lager);
              const trengs = forelder ? forelder.bestilles : leveringsuke;
              rad[del.id] = { brutto, lager, netto, trengs, bestilles: trengs - del.ledetid };
            });
  
            deler.forEach((del) => {
              const r = rad[del.id];
              const sett = (kol, verdi) => {
                const el = ut(del.id + '-' + kol);
                if (el) el.textContent = verdi;
              };
              sett('brutto', tall(r.brutto));
              sett('lager', tall(r.lager));
              sett('netto', tall(r.netto));
              sett('trengs', tall(r.trengs));
              sett('bestilles', tall(r.bestilles));
            });
  
            const melding = ut('melding');
            if (!melding) return;
            delete melding.dataset.advarsel;
  
            if (!antall) {
              melding.textContent = mal.nothing;
              return;
            }
            /* Bare deler som faktisk må skaffes, bestemmer når beslutningen
               tas. Er alt dekket av lager, er det ingen bestilling å time. */
            const aktive = deler.filter((d) => rad[d.id].netto > 0);
            if (!aktive.length) {
              melding.textContent = mal.covered;
              return;
            }
            const tidligst = Math.min(...aktive.map((d) => rad[d.id].bestilles));
            const umulig = tidligst < 1;
            if (umulig) melding.dataset.advarsel = 'ja';
            // Én uke skal ikke skrives «1 uker».
          const grunnmal = umulig
            ? mal.impossible
            : leveringsuke - tidligst === 1
              ? mal.decidedOne
              : mal.decided;
          melding.textContent = grunnmal
              .replace('{uke}', tall(leveringsuke))
              .replace('{tidligst}', tall(tidligst))
              .replace('{diff}', tall(leveringsuke - tidligst));
          };
  
          inn.forEach((el) => el.addEventListener('input', regn));
          form.addEventListener('submit', (e) => e.preventDefault());
          form.dataset.live = 'ja';
          regn();
        });
      };
  
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
)}

{type === 'eoq' && (
  <script
    is:inline
    data-locale={en ? 'en-GB' : 'nb-NO'}
    data-equal={en
      ? 'At the optimum the two costs are equal: {kost} kr each, {total} kr a year.'
      : 'I optimum er de to kostnadene like store: {kost} kr hver, {total} kr i året.'}
    data-penalty={en
      ? 'Ordering {valgt} at a time costs {total} kr a year – {avvik} % above the optimum.'
      : 'Å bestille {valgt} om gangen koster {total} kr i året – {avvik} % over optimum.'}
    data-atoptimum={en
      ? 'Ordering {valgt} at a time is the optimum. Nothing is left to gain.'
      : 'Å bestille {valgt} om gangen er optimum. Det er ingenting igjen å hente.'}
    data-invalid={en
      ? 'Demand, order cost and holding cost must all be above zero.'
      : 'Etterspørsel, bestillingskostnad og lagerkostnad må alle være over null.'}
  >
    (() => {
      const cfg = document.currentScript;
      const locale = cfg.dataset.locale;
      const mal = {
        equal: cfg.dataset.equal,
        penalty: cfg.dataset.penalty,
        atOptimum: cfg.dataset.atoptimum,
        invalid: cfg.dataset.invalid,
      };
      const tall = (n, des = 0) =>
        n.toLocaleString(locale, { minimumFractionDigits: des, maximumFractionDigits: des });

      const start = () => {
        document.querySelectorAll('[data-kalkulator="eoq"]').forEach((form) => {
          const felt = (navn) => form.querySelector('[data-eoq="' + navn + '"]');
          const ut = (navn) => form.querySelector('[data-ut="' + navn + '"]');
          const inn = [...form.querySelectorAll('[data-eoq]')];
          if (!inn.length || !ut('eoq')) return;

          const regn = () => {
            const D = Math.max(0, Number(felt('etterspørsel').value) || 0);
            const S = Math.max(0, Number(felt('bestillingskostnad').value) || 0);
            const H = Math.max(0, Number(felt('lagerkostnad').value) || 0);
            const melding = ut('melding');
            delete melding.dataset.advarsel;

            if (!D || !S || !H) {
              ['eoq', 'ordrer', 'bestilling', 'lager', 'total'].forEach((k) => {
                const el = ut(k);
                if (el) el.textContent = '–';
              });
              melding.dataset.advarsel = 'ja';
              melding.textContent = mal.invalid;
              return;
            }

            // Harris' formel. Kostnaden regnes på det eksakte optimumet, ikke
            // på det avrundede tallet som vises – ellers stemmer ikke likheten
            // mellom de to kostnadene.
            const eoq = Math.sqrt((2 * D * S) / H);
            const bestilling = (D / eoq) * S;
            const lager = (eoq / 2) * H;

            ut('eoq').textContent = tall(Math.round(eoq));
            ut('ordrer').textContent = tall(D / eoq, 1);
            ut('bestilling').textContent = tall(Math.round(bestilling));
            ut('lager').textContent = tall(Math.round(lager));
            ut('total').textContent = tall(Math.round(bestilling + lager));

            const valgt = Math.max(0, Number(felt('parti').value) || 0);
            if (!valgt) {
              melding.textContent = mal.equal
                .replace('{kost}', tall(Math.round(bestilling)))
                .replace('{total}', tall(Math.round(bestilling + lager)));
              return;
            }
            const totalValgt = (D / valgt) * S + (valgt / 2) * H;
            const avvik = (totalValgt / (bestilling + lager) - 1) * 100;
            // Under en tidel av en prosent er det i praksis samme parti.
            melding.textContent =
              avvik < 0.05
                ? mal.atOptimum.replace('{valgt}', tall(valgt))
                : mal.penalty
                    .replace('{valgt}', tall(valgt))
                    .replace('{total}', tall(Math.round(totalValgt)))
                    .replace('{avvik}', tall(avvik, 1));
          };

          inn.forEach((el) => el.addEventListener('input', regn));
          form.addEventListener('submit', (e) => e.preventDefault());
          form.dataset.live = 'ja';
          regn();
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
)}

<style is:global>
  /* Kalkulatoren låner figurenes formspråk: hårfin ramme, nesten rette
     hjørner, ingen skygge. Den skal se ut som en figur du kan skrive i. */
  .kalk {
    margin: clamp(1.8rem, 4vw, 2.6rem) 0;
    padding: 1.3rem 1.4rem 1.4rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-sans);
  }
  .kalk__title {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .kalk__rows {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .kalk__row {
    display: grid;
    grid-template-columns: 1fr auto 5.5rem;
    align-items: center;
    gap: 0.8rem;
    padding: 0.62rem 0.8rem;
    background: var(--surface);
  }
  .kalk__navn {
    font-size: 0.95rem;
    color: var(--ink);
  }
  .kalk__faktor {
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .kalk__inn {
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    text-align: right;
  }
  .kalk__inn:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--focus);
  }
  .kalk__ut {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.9rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .kalk__tall b {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.1rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.021em;
    color: var(--ink);
  }
  .kalk__tall small {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .kalk__skip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
    color: var(--ink);
  }
  .kalk__skip .kalk__inn {
    width: 7rem;
  }
  .kalk__note {
    margin: 0.85rem 0 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--ink-faint);
    max-width: 62ch;
  }
  /* Uten JavaScript er tallrekka bare nuller og forvirrer mer enn den
     hjelper. Da vises oppslagstabellen alene. */
  .kalk:not([data-live]) .kalk__ut,
  .kalk:not([data-live]) .kalk__skip {
    display: none;
  }
  @media (max-width: 480px) {
    .kalk__row {
      grid-template-columns: 1fr 4.5rem;
      row-gap: 0.25rem;
    }
    .kalk__faktor {
      grid-column: 1;
      grid-row: 2;
    }
    .kalk__inn {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  /* MRP-tabellen. Samme uttrykk som .prose table, men tettere – den står
     inne i en ramme og skal kunne leses uten å ta over siden. */
  .kalk__tabell {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.1rem;
    font-size: 0.9rem;
  }
  .kalk__tabell :is(th, td) {
    padding: 0.5rem 0.55rem;
    text-align: right;
    border-bottom: 1px solid var(--line);
  }
  .kalk__tabell :is(thead th, tbody th) {
    text-align: left;
  }
  .kalk__tabell thead th {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border-bottom: 1px solid var(--line-strong);
    text-align: right;
  }
  .kalk__tabell thead th:first-child {
    text-align: left;
  }
  .kalk__tabell tbody th {
    font-weight: 500;
    color: var(--ink);
  }
  .kalk__tabell td {
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }
  /* Bestillingsuka er svaret man kommer for. */
  .kalk__tabell [data-ut$="-bestilles"] {
    color: var(--ink);
    font-weight: 600;
  }
  .kalk__tabell tbody tr:last-child :is(th, td) {
    border-bottom: 0;
  }
  .kalk__note[data-advarsel] {
    color: var(--accent-strong);
  }
  @media (max-width: 560px) {
    .kalk__tabell {
      font-size: 0.82rem;
    }
    .kalk__tabell :is(th, td) {
      padding: 0.42rem 0.3rem;
    }
  }
</style>
