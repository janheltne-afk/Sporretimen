---
import Logo from './Logo.astro';
import { site } from '@/data/site';
import { alternatePath, englishReady, localeName, path as routePath, type Locale } from '@/i18n/config';
import { navItems, useTranslations } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Locale = lang === 'no' ? 'en' : 'no';

const nav = navItems.map((item) => ({ label: item.label[lang], href: routePath(lang, item.key) }));

/**
 * Menylenkene har etterfølgende skråstrek. Vi fjerner den fra begge sider før
 * vi sammenligner, ellers ville ikke en seksjons egen forside (/episoder/,
 * /om/ …) blitt markert som gjeldende side.
 */
const stripSlash = (value: string) => value.replace(/\/+$/, '') || '/';
const here = stripSlash(Astro.url.pathname);
const isActive = (href: string) => {
  const target = stripSlash(href);
  return here === target || (target !== '/' && here.startsWith(`${target}/`));
};

// Språkknappen peker til samme side på det andre språket – en ekte lenke, slik
// at søkemotorer følger den og finner den andre versjonen.
const otherHref = alternatePath(lang, Astro.url.pathname);
---

<header class="site-header">
  <!-- Øverste rad: ordmerket alene, slik det står hos et advokathus -->
  <div class="container site-header__top">
    <a class="site-header__brand" href={routePath(lang, 'home')} aria-label={`${site.name} – ${t('header.home')}`}>
      <Logo sub={`${t('site.subtitle')} ${site.host}`} />
    </a>

    <div class="site-header__actions">
      {englishReady && (
      <a
        class="lang-toggle"
        href={otherHref}
        hreflang={other === 'en' ? 'en' : 'nb'}
        lang={other === 'en' ? 'en' : 'nb'}
        aria-label={t('header.language')}
        title={localeName[other]}
      >
        {t('header.languageShort')}
      </a>
      )}

      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label={t('header.theme')}
        title={t('header.themeShort')}
      >
        <svg class="icon-sun" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19"></path>
          </g>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
        </svg>
      </button>

      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-label={t('header.openMenu')}
        data-open-label={t('header.openMenu')}
        data-close-label={t('header.closeMenu')}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Nederste rad: menyen får sin egen linje og god luft -->
  <nav class="site-nav" aria-label={t('header.menu')}>
    <div class="container">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- Mobilmeny -->
  <nav class="mobile-nav" id="mobile-nav" aria-label={t('header.menu')} hidden>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  /* --------------------------------------------------------- Ordmerkerad */
  .site-header__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 76px;
  }
  .site-header__brand {
    text-decoration: none;
    flex: none;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  /* Språkknappen står ved siden av temaknappen og er en ekte lenke, ikke en
     bryter – den fører til den engelske versjonen av siden du står på. */
  .lang-toggle {
    display: grid;
    place-items: center;
    height: 36px;
    padding-inline: 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink-faint);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .lang-toggle:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    background: transparent;
    color: var(--ink-faint);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .theme-toggle:hover {
    color: var(--ink);
  }
  .theme-toggle .icon-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .icon-moon {
    display: block;
  }
  /* Følg også systemets valg når brukeren ikke har valgt tema selv */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .icon-sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle .icon-moon {
      display: block;
    }
  }

  /* -------------------------------------------------------------- Menyrad */
  .site-nav {
    border-top: 1px solid var(--line);
    /* Løftes over topplinjens bunnkant, så markøren for gjeldende side
       tegnes oppå streken i stedet for under den. */
    position: relative;
    z-index: 1;
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    position: relative;
    display: block;
    padding-block: 0.92rem;
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .site-nav a:hover {
    color: var(--ink);
  }
  /* Hårfin strek under gjeldende side – eneste stedet aksenten brukes her */
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* -------------------------------------------------------------- Mobil */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 0 7px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    height: 1px;
    background: var(--ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.25rem var(--gutter) 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .mobile-nav a {
    display: block;
    padding: 0.95rem 0;
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s ease;
  }
  .mobile-nav a:hover {
    color: var(--ink);
  }
  .mobile-nav li:last-child a {
    border-bottom: 0;
  }
  .mobile-nav a[aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 1180px) {
    .site-nav {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .site-header__top {
      min-height: 68px;
    }
  }
</style>

<script>
  // Mobilmeny
  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  menuToggle?.addEventListener('click', () => {
    const open = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!open));
    const labels = menuToggle.dataset;
    menuToggle.setAttribute('aria-label', open ? labels.openLabel! : labels.closeLabel!);
    if (mobileNav) mobileNav.hidden = open;
  });

  // Temaveksling (lyst/mørkt), lagres i localStorage
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.getAttribute('data-theme') ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('sporretimen-theme', next);
    } catch (e) {
      /* ignore */
    }
  });
</script>
