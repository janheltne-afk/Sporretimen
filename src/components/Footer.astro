---
import Logo from './Logo.astro';
import { site, nav, socials } from '@/data/site';

const year = new Date().getFullYear();
const activeSocials = socials.filter((s) => s.url);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo />
      <p class="site-footer__tag">{site.tagline}</p>
      <a class="site-footer__mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <nav class="site-footer__nav" aria-label="Bunntekstmeny">
      <h2>Innhold</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__social">
      <h2>Følg Spørretimen</h2>
      {
        activeSocials.length > 0 ? (
          <ul>
            {activeSocials.map((s) => (
              <li>
                <a href={s.url!} target="_blank" rel="noopener">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">
            Lenker til YouTube, Spotify, Apple Podcasts og sosiale medier kommer her
            så snart kanalene er klare.
          </p>
        )
      }
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} {site.name}. Alle rettigheter forbeholdt.</p>
    <p class="site-footer__legal">
      <a href="/personvern/">Personvern</a>
      <span class="muted">
        · Spørretimen følger presseetiske prinsipper og Vær Varsom-plakaten der det er
        relevant.
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--line);
    margin-top: auto;
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 2.5rem;
  }
  .site-footer__tag {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin: 0.9rem 0 0.7rem;
    max-width: 22rem;
  }
  .site-footer__mail {
    color: var(--accent-strong);
    font-weight: 600;
    text-decoration: none;
  }
  .site-footer h2 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    margin: 0 0 0.9rem;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .site-footer a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .site-footer a:hover {
    color: var(--accent-strong);
  }
  .site-footer__bottom {
    border-top: 1px solid var(--line);
    padding-block: 1.4rem 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .site-footer__bottom p {
    margin: 0;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .site-footer__legal a {
    color: var(--ink-faint);
    text-decoration: underline;
  }
  .site-footer__legal a:hover {
    color: var(--accent-strong);
  }
  @media (max-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
