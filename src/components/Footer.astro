---
import Logo from './Logo.astro';
import { site, socials } from '@/data/site';
import { path as routePath, type Locale } from '@/i18n/config';
import { navItems, useTranslations } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const nav = navItems.map((item) => ({ label: item.label[lang], href: routePath(lang, item.key) }));
const year = new Date().getFullYear();
const activeSocials = socials.filter((s) => s.url);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo />
      <p class="site-footer__tag">{t('site.tagline')}</p>
      <a class="site-footer__mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <nav class="site-footer__nav" aria-label={t('footer.contents')}>
      <h2>{t('footer.contents')}</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__social">
      <h2>{t('footer.follow')}</h2>
      {
        activeSocials.length > 0 ? (
          <ul>
            {activeSocials.map((s) => (
              <li>
                <a href={s.url!} target="_blank" rel="noopener">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">{t('footer.socialsComing')}</p>
        )
      }
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} {site.name}. {t('footer.rights')}</p>
    <p class="site-footer__legal">
      <a href={routePath(lang, 'privacy')}>{t('footer.privacy')}</a>
      <a href={routePath(lang, 'terms')}>{t('footer.terms')}</a>
      <span class="muted">· {t('footer.ethicsNote')}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--line);
    margin-top: auto;
    padding-top: clamp(3.25rem, 6vw, 5rem);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .site-footer__tag {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 1.1rem 0 1rem;
    max-width: 24ch;
  }
  .site-footer__mail {
    color: var(--ink);
    font-size: 0.92rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.15rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .site-footer__mail:hover {
    color: var(--accent-strong);
    border-color: var(--accent);
  }
  .site-footer h2 {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink-faint);
    margin: 0 0 1.15rem;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .site-footer a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }
  .site-footer a:hover {
    color: var(--ink);
  }
  .site-footer__bottom {
    border-top: 1px solid var(--line);
    padding-block: 1.6rem 2.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem 2.5rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .site-footer__bottom p {
    margin: 0;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }
  .site-footer__legal a {
    color: var(--ink-faint);
    font-size: 0.8rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }
  .site-footer__legal a:hover {
    color: var(--ink);
  }
  @media (max-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
