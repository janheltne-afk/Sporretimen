---
import type { CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';

interface Props {
  guest: CollectionEntry<'guests'>;
}
const { guest } = Astro.props;
const d = guest.data;
---

<article class="card guest">
  <a class="guest__link" href={`/gjester/${guest.id}/`}>
    <Avatar name={d.name} src={d.image} alt={d.imageAlt} ratio="4 / 3" />
    <div class="guest__body">
      <span class="guest__role">{d.role}</span>
      <h3 class="guest__name">{d.name}</h3>
      <p class="guest__intro">{d.intro}</p>
    </div>
  </a>
</article>

<style>
  .guest {
    overflow: hidden;
  }
  .guest__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .guest__body {
    padding: 1.25rem 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .guest__role {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .guest__name {
    margin: 0;
    font-size: 1.3rem;
    letter-spacing: -0.015em;
    transition: color 0.2s ease;
  }
  .guest__intro {
    margin: 0.15rem 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .guest__link:hover .guest__name {
    color: var(--accent-strong);
  }
</style>
