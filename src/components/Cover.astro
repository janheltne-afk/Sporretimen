---
import { placeholderColor } from '@/lib/utils';
import { formatById } from '@/data/site';

/**
 * Episodeomslag. Viser et bilde hvis `src` er satt, ellers en pen
 * plassholder med formatnavn og aksentfarge utledet av tittelen.
 */
interface Props {
  src?: string;
  alt?: string;
  title: string;
  format: string;
  ratio?: string;
  class?: string;
}
const { src, alt, title, format, ratio = '16 / 10', class: className = '' } = Astro.props;
const [bg, fg] = placeholderColor(title);
const label = formatById(format)?.singular ?? 'Episode';
---

<div class:list={['cover', className]} style={`--ratio:${ratio}`}>
  {
    src ? (
      <img src={src} alt={alt ?? title} loading="lazy" decoding="async" />
    ) : (
      <div class="cover__ph" style={`--ph-bg:${bg}; --ph-fg:${fg}`} aria-hidden="true">
        <span class="cover__label">{label}</span>
        <svg viewBox="0 0 120 120" class="cover__deco" aria-hidden="true">
          <circle cx="60" cy="52" r="34" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5" />
          <path
            d="M48 44c0-7 5.5-11.5 12.5-11.5S73 37 73 43.5c0 5-3 7.7-7 10.2-3.4 2.1-4.8 3.8-4.8 7v1.4"
            fill="none"
            stroke="currentColor"
            stroke-width="3.2"
            stroke-linecap="round"
          />
          <circle cx="61" cy="71" r="3.4" fill="currentColor" />
        </svg>
      </div>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
    background: var(--surface-2);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--ph-bg), color-mix(in srgb, var(--ph-bg) 60%, #fff));
    color: var(--ph-fg);
  }
  .cover__deco {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 46%;
    height: auto;
    opacity: 0.85;
  }
  .cover__label {
    position: absolute;
    left: 0.9rem;
    bottom: 0.8rem;
    z-index: 1;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ph-fg);
    background: color-mix(in srgb, var(--ph-bg) 45%, #fff);
    padding: 0.24rem 0.6rem;
    border-radius: 999px;
  }
</style>
