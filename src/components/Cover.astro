---
import { site } from '@/data/site';

/**
 * Episodeomslag.
 *
 * Har episoden en gjest, brukes gjestens behandlede portrett: personen klippet
 * ut og satt på en varm, mørk flate (se scripts/lag-omslag.py). Over det settes
 * seriemerket og episodens tema i nettsidens egen typografi – ikke brent inn i
 * bildefilen, så teksten er skarp i alle størrelser og lesbar for skjermlesere.
 *
 * Uten gjest vises samme flate uten portrett.
 *
 * `coverStyle: bilde` viser i stedet filen i `image`, for omslag som holder mål
 * på egen hånd. Den filen brukes uansett som delebilde i sosiale medier.
 */
interface Props {
  src?: string;
  alt?: string;
  title: string;
  format: string;
  ratio?: string;
  variant?: 'plate' | 'bilde';
  /** Behandlet gjesteportrett på mørk flate. */
  portrait?: string;
  /** Kort temalinje, f.eks. «Kanada-ekspedisjonen». */
  theme?: string;
  class?: string;
}
const {
  src,
  alt,
  title,
  format,
  ratio = '16 / 9',
  variant = 'plate',
  portrait,
  theme,
  class: className = '',
} = Astro.props;

const useImage = variant === 'bilde' && Boolean(src);
---

{
  useImage ? (
    <div class:list={['cover', className]} style={`--ratio:${ratio}`}>
      <img src={src} alt={alt ?? title} loading="lazy" decoding="async" />
    </div>
  ) : (
    <div
      class:list={['cover', 'cover--plate', `plate--${format}`, className]}
      style={`--ratio:${ratio}`}
      aria-hidden="true"
    >
      {portrait && <img class="plate__portrait" src={portrait} alt="" loading="lazy" decoding="async" />}
      <div class:list={['plate__inner', { 'plate__inner--senter': !portrait }]}>
        <span class="plate__mark">{site.name}</span>
        <span class="plate__rule" />
        {theme && <span class="plate__theme">{theme}</span>}
      </div>
    </div>
  )
}

<style>
  .cover {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--surface-2);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Felles gradering, se --img-grade i global.css */
    filter: var(--img-grade);
    transition: filter 0.45s ease;
  }
  /* Varm hinne som demper de skarpeste omslagene og binder dem til paletten */
  .cover:not(.cover--plate)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--img-veil-color);
    opacity: var(--img-veil);
    pointer-events: none;
    transition: opacity 0.45s ease;
  }
  /* Hårfin innramming, så lyse omslag ikke flyter ut i kortet */
  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    box-shadow: inset 0 0 0 1px rgba(22, 19, 15, 0.09);
    pointer-events: none;
  }

  /* -------------------------------------------------------------- Omslaget
     Målene er i cqw, så samme omslag fungerer både som lite kort på forsiden
     og som stor plate på episodesiden. */
  .cover--plate {
    container-type: inline-size;
    color: #f2ece2;
    /* Samme varme, nær-svarte flate som portrettene er satt på, slik at
       omslag med og uten portrett hører sammen. */
    background:
      radial-gradient(105% 90% at 74% 6%, rgba(201, 141, 78, 0.15), transparent 62%),
      #12100d;
  }
  .cover--plate::before {
    box-shadow: inset 0 0 0 1px rgba(242, 236, 226, 0.11);
  }
  /* Må være like spesifikk som `.cover img`, ellers graderes portrettet på nytt
     oppå graderingen som allerede ligger i bildefilen. */
  .cover img.plate__portrait {
    position: absolute;
    inset: 0;
    filter: none;
  }
  .plate__inner {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 3cqw;
    padding: 7cqw;
    /* Mørkner venstre side der teksten står, uten å røre ansiktet til høyre */
    background: linear-gradient(
      96deg,
      rgba(14, 12, 10, 0.9) 0%,
      rgba(14, 12, 10, 0.78) 30%,
      rgba(14, 12, 10, 0.3) 52%,
      rgba(14, 12, 10, 0) 68%
    );
  }
  .plate__inner--senter {
    align-items: center;
    justify-content: center;
    text-align: center;
    background: none;
  }
  .plate__mark {
    font-family: var(--font-sans);
    font-size: 2.9cqw;
    font-weight: 500;
    letter-spacing: 0.28em;
    /* Sperringen legger luft til høyre for siste tegn – trekkes fra igjen */
    margin-right: -0.28em;
    text-transform: uppercase;
    color: rgba(242, 236, 226, 0.66);
    line-height: 1;
  }
  .plate__rule {
    display: block;
    width: 7cqw;
    height: 1px;
    margin-top: -1cqw;
    background: var(--plate-tone, #c9955c);
    opacity: 0.8;
  }
  .plate__theme {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 5.9cqw;
    line-height: 1.14;
    letter-spacing: -0.018em;
    /* Holder teksten klar av figuren, som står til høyre i bildet */
    max-width: 42%;
    text-wrap: balance;
  }
  .plate__inner--senter .plate__theme {
    max-width: 78%;
  }

  /* Hvert format får sin egen tone, så platene ikke blir like flater på rad */
  .plate--laer-noe-nytt {
    --plate-tone: #9aabd8;
  }
  .plate--kort-forklart {
    --plate-tone: #dfa373;
  }
  .plate--laer-noe-nytt:not(:has(.plate__portrait)) {
    background:
      radial-gradient(110% 95% at 78% 4%, rgba(122, 141, 190, 0.15), transparent 62%),
      #12141a;
  }
  .plate--kort-forklart:not(:has(.plate__portrait)) {
    background:
      radial-gradient(105% 100% at 50% 112%, rgba(198, 122, 70, 0.16), transparent 64%),
      #171310;
  }
</style>
