---
import { formatById, site } from '@/data/site';

/**
 * Episodeomslag. Viser episodens eget bilde hvis `src` er satt, ellers den
 * generelle Spørretimen-plassholderen med formatnavnet lagt oppå.
 */
interface Props {
  src?: string;
  alt?: string;
  title: string;
  format: string;
  ratio?: string;
  class?: string;
}
const { src, alt, title, format, ratio = '16 / 10', class: className = '' } = Astro.props;
const label = formatById(format)?.singular ?? 'Episode';
const isPlaceholder = !src;
const image = src ?? site.placeholderImage;
---

<div class:list={['cover', { 'cover--placeholder': isPlaceholder }, className]} style={`--ratio:${ratio}`}>
  <img src={image} alt={alt ?? title} loading="lazy" decoding="async" />
  {isPlaceholder && <span class="cover__label">{label}</span>}
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--surface-2);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover--placeholder {
    background: #16130f;
  }
  .cover__label {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    z-index: 1;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.66rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #fffdf9;
    border: 1px solid rgba(255, 253, 249, 0.5);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
  }
</style>
