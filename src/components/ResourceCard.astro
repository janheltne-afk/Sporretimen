---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import { resourceTypeById, allResourceTypes } from '@/data/site';

interface Props {
  resource: CollectionEntry<'resources'>;
}
const { resource } = Astro.props;
const d = resource.data;
const types = allResourceTypes(d);

// Første episode ressursen er nevnt i (for en liten «Fra»-lenke).
const firstEpisode = d.episodes.length ? await getEntry(d.episodes[0]) : undefined;
---

<article class="card resource">
  <a class="resource__link" href={`/ressurser/${resource.id}/`}>
    <div class="resource__body">
      <div class="resource__meta">
        {types.map((t) => (
          <span class:list={['tag', `rtype-${t}`]}>{resourceTypeById(t)?.label}</span>
        ))}
        {d.language && <span class="resource__lang">{d.language}</span>}
      </div>
      <h3 class="resource__title">{d.title}</h3>
      {d.author && <p class="resource__author">{d.author}</p>}
      <p class="resource__summary">{d.summary}</p>
      <div class="resource__foot">
        {d.categories.slice(0, 2).map((c) => <span class="resource__cat">{c}</span>)}
        {firstEpisode && <span class="resource__from">Fra episode</span>}
      </div>
    </div>
  </a>
</article>

<style>
  .resource {
    overflow: hidden;
  }
  .resource__link {
    display: flex;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .resource__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.4rem 1.45rem 1.5rem;
    width: 100%;
  }
  .resource__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .resource__lang {
    font-size: 0.63rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-sm);
    line-height: 1.35;
  }
  .resource__title {
    margin: 0.3rem 0 0;
    font-size: 1.24rem;
    line-height: 1.24;
    letter-spacing: -0.015em;
    transition: color 0.2s ease;
  }
  .resource__link:hover .resource__title {
    color: var(--accent-strong);
  }
  .resource__author {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .resource__summary {
    margin: 0.15rem 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .resource__foot {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .resource__from {
    font-weight: 600;
    color: var(--ink-faint);
  }

  /* Typefarger – kun tekst og hårfin ramme, aldri fylte flater */
  .rtype-bok {
    color: var(--tag-laer);
    border-color: color-mix(in srgb, var(--tag-laer) 38%, transparent);
  }
  .rtype-husketeknikk {
    color: var(--tag-samtale);
    border-color: color-mix(in srgb, var(--tag-samtale) 38%, transparent);
  }
  .rtype-tips {
    color: var(--tag-kort);
    border-color: color-mix(in srgb, var(--tag-kort) 38%, transparent);
  }
  .rtype-verktoy,
  .rtype-podkast {
    color: var(--accent-strong);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .rtype-artikkel {
    color: var(--ink-soft);
    border-color: var(--line-strong);
  }
</style>
