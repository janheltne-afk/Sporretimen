---
/**
 * Felles oversiktsside for innhold.
 *
 * Brukes av /episoder (hele arkivet), /samtaler (Spørretimen) og /forklart
 * (Spørretimen Forklart), og av temasidene. Kalleren sender inn de episodene
 * som skal vises – filtrering på serie gjøres der, ikke her.
 *
 * Filtrering og søk skjer i nettleseren på ferdig bygget HTML. Det holder
 * lenge på dette volumet, og alt innholdet ligger uansett i kildekoden for
 * søkemotorene. Skulle arkivet vokse forbi noen hundre episoder, er dette
 * stedet å bytte til sideinndeling.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import { getEntry, type CollectionEntry } from 'astro:content';
import { type Locale } from '@/i18n/config';
import { formatList } from '@/i18n/taxonomy';
import { topics, topicById } from '@/data/topics';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: Locale;
  episodes: CollectionEntry<'episodes'>[];
  eyebrow: string;
  title: string;
  lead?: string;
  /** Sidetittel og beskrivelse for <head>. Faller tilbake til title/lead. */
  metaTitle?: string;
  metaDescription?: string;
  /** Slå av formatfilteret der det ikke gir mening (f.eks. /samtaler). */
  showFormatFilter?: boolean;
  showTopicFilter?: boolean;
  showSearch?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang,
  episodes,
  eyebrow,
  title,
  lead,
  metaTitle,
  metaDescription,
  showFormatFilter = true,
  showTopicFilter = true,
  showSearch = true,
  jsonLd,
} = Astro.props;

const t = useTranslations(lang);
const en = lang === 'en';

/** Hovedtemaene episoden hører under – hovedtema pluss undertemaenes eiere. */
function topicsOf(data: { topic: string; subtopics: string[] }): string[] {
  const ids = new Set<string>([data.topic]);
  for (const topic of topics) {
    const own = new Set(topic.subtopics.map((s) => s.id));
    if (data.subtopics.some((s) => own.has(s))) ids.add(topic.id);
  }
  return [...ids];
}

/** Alt som skal kunne søkes i, som én liten tekstklump per kort. */
async function haystack(ep: CollectionEntry<'episodes'>): Promise<string> {
  const d = ep.data;
  const guest = d.guest ? await getEntry(d.guest) : undefined;
  const topicNames = topicsOf(d).map((id) => topicById(id)?.label[lang] ?? '');
  const subNames = d.subtopics.map(
    (id) => topics.flatMap((x) => x.subtopics).find((s) => s.id === id)?.label[lang] ?? ''
  );
  return [
    d.title,
    d.description,
    d.yrke ?? '',
    guest?.data.name ?? '',
    guest?.data.role ?? '',
    ...topicNames,
    ...subNames,
    ...d.topics,
    ...d.questions,
    ...d.tags,
  ]
    .join(' ')
    .toLowerCase();
}

const items = await Promise.all(
  episodes.map(async (ep) => ({
    ep,
    topics: topicsOf(ep.data).join('|'),
    search: await haystack(ep),
  }))
);

// Bare filtre det faktisk er noe å filtrere på.
const usedFormats = formatList(lang).filter((f) => episodes.some((e) => e.data.format === f.id));
const usedTopics = topics.filter((topic) =>
  items.some((i) => i.topics.split('|').includes(topic.id))
);
const formatFilter = showFormatFilter && usedFormats.length > 1;
const topicFilter = showTopicFilter && usedTopics.length > 1;
---

<BaseLayout
  lang={lang}
  title={metaTitle ?? title}
  description={metaDescription ?? lead}
  jsonLd={jsonLd}
>
  <PageHeader wide eyebrow={eyebrow} title={title} lead={lead} />

  <section class="section-tight">
    <div class="container">
      {
        (formatFilter || topicFilter || showSearch) && (
          <div class="filters" role="group" aria-label={en ? 'Filter content' : 'Filtrer innhold'}>
            {showSearch && (
              <div class="filters__search">
                <label class="filters__label" for="content-search">
                  {t('search.label')}
                </label>
                <input
                  type="search"
                  id="content-search"
                  data-role="search"
                  placeholder={t('search.placeholder')}
                  autocomplete="off"
                />
              </div>
            )}
            {formatFilter && (
              <div class="filters__group" data-filter-group="format">
                <span class="filters__label">{t('filter.format')}</span>
                <button class="chip is-active" data-value="alle" aria-pressed="true">
                  {t('filter.all')}
                </button>
                {usedFormats.map((f) => (
                  <button class="chip" data-value={f.id} aria-pressed="false">
                    {f.label}
                  </button>
                ))}
              </div>
            )}
            {topicFilter && (
              <div class="filters__group" data-filter-group="topic">
                <span class="filters__label">{t('filter.topic')}</span>
                <button class="chip is-active" data-value="alle" aria-pressed="true">
                  {t('filter.all')}
                </button>
                {usedTopics.map((topic) => (
                  <button class="chip" data-value={topic.id} aria-pressed="false">
                    {topic.label[lang]}
                  </button>
                ))}
              </div>
            )}
          </div>
        )
      }

      <p
        class="results-count muted"
        id="results-count"
        aria-live="polite"
        data-one={t('filter.countOne')}
        data-many={t('filter.countMany')}
      ></p>

      <div class="grid grid-3" id="episode-grid">
        {
          items.map((item) => (
            <div
              class="episode-item"
              data-format={item.ep.data.format}
              data-topics={item.topics}
              data-search={item.search}
            >
              <EpisodeCard lang={lang} episode={item.ep} />
            </div>
          ))
        }
      </div>

      <p class="no-results" id="no-results" hidden>{t('filter.none')}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 1.4rem;
  }
  .filters__group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .filters__search {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .filters__search input {
    flex: 1;
    min-width: 12rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
  }
  .filters__search input:focus {
    outline: none;
    border-color: var(--ink);
  }
  .filters__label {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    color: var(--ink-faint);
    margin-right: 0.35rem;
    min-width: 3.5rem;
  }
  .chip {
    padding: 0.48rem 0.95rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink-soft);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 450;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .chip.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .results-count {
    margin: 0 0 1.2rem;
    font-size: 0.9rem;
  }
  .no-results {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--ink-faint);
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('.episode-item'));
  const countEl = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const searchEl = document.querySelector<HTMLInputElement>('[data-role="search"]');
  const state = { format: 'alle', topic: 'alle', q: '' };

  function apply() {
    let visible = 0;
    items.forEach((item) => {
      const f = item.dataset.format ?? '';
      const tops = (item.dataset.topics ?? '').split('|');
      const hay = item.dataset.search ?? '';
      const show =
        (state.format === 'alle' || f === state.format) &&
        (state.topic === 'alle' || tops.includes(state.topic)) &&
        (state.q === '' || hay.includes(state.q));
      item.hidden = !show;
      if (show) visible++;
    });
    if (countEl) {
      const unit = visible === 1 ? countEl.dataset.one : countEl.dataset.many;
      countEl.textContent = `${visible} ${unit}`;
    }
    if (noResults) noResults.hidden = visible !== 0;
  }

  document.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
    const key = group.dataset.filterGroup as 'format' | 'topic';
    group.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        group.querySelectorAll('.chip').forEach((c) => {
          c.classList.remove('is-active');
          c.setAttribute('aria-pressed', 'false');
        });
        chip.classList.add('is-active');
        chip.setAttribute('aria-pressed', 'true');
        state[key] = chip.dataset.value ?? 'alle';
        apply();
      });
    });
  });

  searchEl?.addEventListener('input', () => {
    state.q = searchEl.value.trim().toLowerCase();
    apply();
  });

  /** Forhåndsvelger et filter fra adressen, f.eks. ?format=kort-forklart. */
  function preset(group: string, value: string | null) {
    if (!value) return false;
    const btn = document.querySelector<HTMLButtonElement>(
      `[data-filter-group="${group}"] .chip[data-value="${CSS.escape(value)}"]`
    );
    if (!btn) return false;
    btn.click();
    return true;
  }

  const params = new URLSearchParams(window.location.search);
  const q = params.get('q');
  if (q && searchEl) {
    searchEl.value = q;
    state.q = q.trim().toLowerCase();
  }
  const didFormat = preset('format', params.get('format'));
  const didTopic = preset('topic', params.get('tema') ?? params.get('topic'));
  if (!didFormat && !didTopic) apply();
</script>
