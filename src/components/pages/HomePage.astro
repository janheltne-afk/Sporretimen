---
/**
 * Forsiden. Spørretimen som hele universet, med de to sporene under.
 *
 * Rekkefølgen er bevisst: først det nyeste på tvers av begge seriene, så
 * forklaringen av hva de to sporene er, så temaene. Økonomi er ett tema blant
 * flere her – det skal ikke prege forsiden mer enn de andre.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import Avatar from '@/components/Avatar.astro';
import TopicIcon from '@/components/TopicIcon.astro';
import Interest from '@/components/Interest.astro';
import { getEpisodes, getSeriesEpisodes, slugOf, topicCounts } from '@/lib/content';
import { popularEpisodes } from '@/lib/popularity';
import { site } from '@/data/site';
import { topics } from '@/data/topics';
import { probes } from '@/data/probes';
import { entryPath, path as routePath, topicPath, type Locale } from '@/i18n/config';
import { seriesById } from '@/i18n/taxonomy';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';

const episodes = await getEpisodes(lang);
const published = episodes.filter((e) => e.data.status === 'publisert');
const conversations = await getSeriesEpisodes(lang, 'sporretimen', episodes);
const explained = await getSeriesEpisodes(lang, 'sporretimen-forklart', episodes);
const counts = await topicCounts(lang);

const sporretimen = seriesById(lang, 'sporretimen')!;
const forklart = seriesById(lang, 'sporretimen-forklart')!;

// Kan være tom mens et språk ennå ikke har innhold – da skal siden fortsatt
// bygge, bare uten knappen til «siste episode».
const featuredEpisode = published.find((e) => e.data.featured) ?? published[0];

// Nyeste på tvers av begge seriene. Seks kort, ikke tre – tre ble for lite.
const latest = episodes.slice(0, 6);
const popular = popularEpisodes(published, 3);

// De to seksjonene under viser helst noe som ikke alt står i «Nyeste», men
// faller tilbake når arkivet er lite.
const notInLatest = (list: typeof episodes) => {
  const shown = new Set(latest.map((e) => e.id));
  const fresh = list.filter((e) => !shown.has(e.id));
  return (fresh.length >= 3 ? fresh : list).slice(0, 3);
};
const pickedConversations = notInLatest(conversations);
const pickedExplained = notInLatest(explained);

// Temaene på forsiden: de som har innhold, i registerets rekkefølge.
const shownTopics = topics.filter((topic) => (counts.get(topic.id) ?? 0) > 0);

const talkAreas = en
  ? [
      'Economics and decisions',
      'AI and the future of work',
      'From data to decision',
      'Learning and memory',
      'Technology and business',
    ]
  : [
      'Økonomi og beslutninger',
      'AI og fremtidens arbeidsliv',
      'Fra data til beslutning',
      'Læring og hukommelse',
      'Teknologi og næringsliv',
    ];
---

<BaseLayout lang={lang}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1 class="hero__title">
          {en ? (
            <>Good questions.<br />Interesting people.<br /><span class="hero__accent">New perspectives.</span></>
          ) : (
            <>Gode spørsmål.<br />Interessante mennesker.<br /><span class="hero__accent">Nye perspektiver.</span></>
          )}
        </h1>
        <p class="lead hero__lead">{t('site.description')}</p>
        <div class="hero__actions">
          {featuredEpisode && (
            <a class="btn" href={entryPath(lang, 'episodes', slugOf(featuredEpisode.id))}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5v14l11-7z" fill="currentColor"></path></svg>
              {en ? 'Latest episode' : 'Se siste episode'}
            </a>
          )}
          <a class:list={['btn', { 'btn-secondary': Boolean(featuredEpisode) }]} href={routePath(lang, 'explained')}>
            {en ? 'Explore Explained' : 'Utforsk Forklart'}
          </a>
        </div>
      </div>

      <figure class="hero__media">
        <div class="hero__portrait">
          {/* Bildet er kvadratisk og har Spørretimen-merket inne i seg.
              Et annet forhold beskjærer sidene og kutter ordet. */}
          <Avatar
            name={site.host}
            src={site.hostImage}
            alt={en
              ? `${site.host}, host of Spørretimen`
              : `${site.host}, programleder i Spørretimen`}
            ratio="1 / 1"
          />
        </div>
        <figcaption class="hero__caption">
          <strong>{site.host}</strong>
          <span>{t('episode.host')}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Nyeste, på tvers av begge seriene -->
  <section class="section" aria-labelledby="latest-heading">
    <div class="container">
      <div class="row-head">
        <div>
          <p class="eyebrow">{en ? 'Latest' : 'Nyeste'}</p>
          <h2 id="latest-heading">{en ? 'New and upcoming' : 'Nytt og kommende'}</h2>
        </div>
        <a class="btn btn-secondary btn-sm" href={routePath(lang, 'episodes')}>
          {t('episode.allEpisodes')}
        </a>
      </div>
      <div class="grid grid-3">
        {latest.map((ep) => <EpisodeCard lang={lang} episode={ep} />)}
      </div>
    </div>
  </section>

  <!-- To podkaster, ett univers -->
  <section class="section series" aria-labelledby="series-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{en ? 'Two podcasts, one universe' : 'To podkaster – ett univers'}</p>
        <h2 id="series-heading">
          {en ? 'The people, and the ideas' : 'Menneskene, og ideene'}
        </h2>
      </div>
      <div class="series__pair">
        <article class="series__card">
          <p class="series__kicker">{sporretimen.label}</p>
          <h3 class="series__title">{sporretimen.kicker}</h3>
          <p class="series__desc">{sporretimen.blurb}</p>
          <a class="btn btn-secondary" href={routePath(lang, 'conversations')}>
            {en ? 'See the conversations' : 'Se samtaler'}
          </a>
        </article>
        <article class="series__card series__card--explained">
          <p class="series__kicker">{forklart.label}</p>
          <h3 class="series__title">{forklart.kicker}</h3>
          <p class="series__desc">{forklart.blurb}</p>
          <a class="btn btn-secondary" href={routePath(lang, 'explained')}>
            {en ? 'Explore Explained' : 'Utforsk Forklart'}
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Utforsk temaer -->
  <section class="section" aria-labelledby="topics-heading">
    <div class="container">
      <div class="row-head">
        <div>
          <p class="eyebrow">{en ? 'Topics' : 'Temaer'}</p>
          <h2 id="topics-heading">{t('topic.explore')}</h2>
        </div>
        <a class="btn btn-secondary btn-sm" href={routePath(lang, 'topics')}>{t('topic.all')}</a>
      </div>
      <ul class="topics">
        {
          shownTopics.map((topic) => (
            <li>
              <a class="topics__item" href={topicPath(lang, topic.id)}>
                <span class="topics__icon"><TopicIcon name={topic.icon} size={20} /></span>
                <span class="topics__text">
                  <span class="topics__name">{topic.label[lang]}</span>
                  <span class="topics__blurb">{topic.blurb[lang]}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Populært akkurat nå -->
  {
    popular.length > 0 && (
      <section class="section popular" aria-labelledby="popular-heading">
        <div class="container">
          <div class="row-head">
            <div>
              <p class="eyebrow">{en ? 'Popular right now' : 'Populært akkurat nå'}</p>
              <h2 id="popular-heading">{en ? 'What people are listening to' : 'Det folk hører på'}</h2>
            </div>
          </div>
          <div class="grid grid-3">
            {popular.map((ep) => (
              <EpisodeCard lang={lang} episode={ep} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Samtaler -->
  {
    pickedConversations.length > 0 && (
      <section class="section" aria-labelledby="conv-heading">
        <div class="container">
          <div class="row-head">
            <div>
              <p class="eyebrow">{sporretimen.label}</p>
              <h2 id="conv-heading">{en ? 'Conversations' : 'Samtaler'}</h2>
            </div>
            <a class="btn btn-secondary btn-sm" href={routePath(lang, 'conversations')}>
              {en ? 'All conversations' : 'Alle samtaler'}
            </a>
          </div>
          <div class="grid grid-3">
            {pickedConversations.map((ep) => (
              <EpisodeCard lang={lang} episode={ep} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Forklart -->
  {
    pickedExplained.length > 0 && (
      <section class="section" aria-labelledby="expl-heading">
        <div class="container">
          <div class="row-head">
            <div>
              <p class="eyebrow">{forklart.label}</p>
              <h2 id="expl-heading">{en ? 'Explained' : 'Forklart'}</h2>
            </div>
            <a class="btn btn-secondary btn-sm" href={routePath(lang, 'explained')}>
              {en ? 'All of Explained' : 'Alt i Forklart'}
            </a>
          </div>
          <div class="grid grid-3">
            {pickedExplained.map((ep) => (
              <EpisodeCard lang={lang} episode={ep} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Hva vil du lære mer om? -->
  <section class="section probes" aria-labelledby="probes-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{en ? 'Help us choose' : 'Hjelp oss å velge'}</p>
        <h2 id="probes-heading">{en ? 'What do you want to learn more about?' : 'Hva vil du lære mer om?'}</h2>
        <p class="lead">{t('interest.moreIntro')}</p>
      </div>
      <ul class="probes__grid">
        {
          probes.map((probe) => (
            <li class="probes__card card">
              <h3 class="probes__title">{probe.label[lang]}</h3>
              <p class="probes__blurb">{probe.blurb[lang]}</p>
              <Interest lang={lang} kind="topic" slug={probe.subtopic} label={t('interest.wantMore')} compact />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Jan Sindre -->
  <section class="section host" aria-labelledby="host-heading">
    <div class="container host__inner">
      <div class="host__portrait">
        <Avatar
          name={site.host}
          src={site.hostImage}
          alt={en ? `${site.host}, host of Spørretimen` : `${site.host}, programleder i Spørretimen`}
          ratio="1 / 1"
        />
      </div>
      <div>
        <p class="eyebrow">{en ? 'Host' : 'Programleder'}</p>
        <h2 id="host-heading">{site.host}</h2>
        <p class="host__role">{en ? 'Host and explainer' : 'Programleder og fagformidler'}</p>
        <p class="lead">
          {en
            ? 'He uses Spørretimen to explore economics, technology, business, learning and how people make decisions – through the guests, and through the explainers he writes and records himself.'
            : 'Han bruker Spørretimen til å utforske økonomi, teknologi, næringsliv, læring og menneskelig beslutningstaking – gjennom gjestene, og gjennom forklaringene han skriver og spiller inn selv.'}
        </p>
        <a class="btn btn-secondary" href={routePath(lang, 'profile')}>{en ? 'Read more' : 'Les mer'}</a>
      </div>
    </div>
  </section>

  <!-- Foredrag -->
  <section class="section talks">
    <div class="container talks__inner">
      <div>
        <p class="eyebrow">{en ? 'Talks and collaboration' : 'Foredrag og samarbeid'}</p>
        <h2>{en ? 'From the podcast to the stage' : 'Fra podkasten til scenen'}</h2>
        <p class="lead">
          {en
            ? 'Some of the subjects explored through Spørretimen are developed further into talks and presentations for companies and events.'
            : 'Noen av temaene som utforskes gjennom Spørretimen utvikles videre til foredrag og presentasjoner for bedrifter og arrangementer.'}
        </p>
        <a class="btn btn-secondary" href={routePath(lang, 'foredrag')}>{en ? 'Explore talks' : 'Utforsk foredrag'}</a>
      </div>
      <ul class="talks__areas">
        {talkAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero – rolig og redaksjonell. Ingen gradienter, ingen skjeve kort. */
  .hero {
    padding-block: clamp(3rem, 8vw, 6.5rem);
    border-bottom: 1px solid var(--line);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .hero__title {
    margin: 0 0 1.4rem;
    max-width: 15ch;
  }
  .hero__accent {
    font-style: italic;
    color: var(--ink-soft);
  }
  .hero__lead {
    max-width: 44ch;
    margin-bottom: 2.2rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
  }
  .hero__media {
    margin: 0;
    justify-self: end;
    width: min(380px, 100%);
  }
  .hero__portrait {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .hero__caption {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }
  .hero__caption strong {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
  }
  .hero__caption span {
    color: var(--ink-faint);
    font-size: 0.78rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  /* Seksjonshode med handling til høyre */
  .row-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.8rem, 3.5vw, 2.75rem);
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--line);
  }
  .row-head h2 {
    margin: 0;
  }
  .row-head .eyebrow {
    margin-bottom: 0.55rem;
  }

  /* To podkaster – ett univers. Samme kort, samme familie; det andre får
     bare en tynn markering i kanten så de leses som to. */
  .series {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .series__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .series__card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.7rem, 3vw, 2.4rem);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .series__card--explained {
    border-left: 3px solid var(--accent);
  }
  .series__kicker {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .series__title {
    margin: 0.2rem 0 0;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
  }
  .series__desc {
    margin: 0.4rem 0 1.4rem;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 40ch;
  }
  .series__card .btn {
    align-self: flex-start;
    margin-top: auto;
  }

  /* Temaer – en tolinjers liste, ikke enda en kortvegg. */
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .topics li {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .topics__item {
    display: flex;
    gap: 0.95rem;
    align-items: flex-start;
    height: 100%;
    padding: 1.35rem 1.4rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease;
  }
  .topics__item:hover {
    background: var(--surface);
  }
  .topics__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .topics__item:hover .topics__icon {
    color: var(--accent-strong);
    border-color: var(--accent);
  }
  .topics__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .topics__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
  }
  .topics__blurb {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .popular {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  /* Hva vil du lære mer om? */
  .probes {
    border-top: 1px solid var(--line);
  }
  .probes .section-head .lead {
    max-width: 56ch;
  }
  .probes__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .probes__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 1.5rem 1.6rem;
  }
  .probes__title {
    margin: 0;
    font-size: 1.2rem;
  }
  .probes__blurb {
    margin: 0 0 0.9rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.55;
    flex: 1;
  }

  /* Programlederen. Kort og saklig. */
  .host {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .host__inner {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .host__portrait {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .host h2 {
    margin-bottom: 0.3rem;
  }
  .host__role {
    margin: 0 0 1.1rem;
    color: var(--ink-faint);
    font-size: 0.78rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .host .lead {
    max-width: 52ch;
    margin-bottom: 1.6rem;
  }

  /* Foredrag – nederst, og med vilje lite. */
  .talks__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .talks h2 {
    max-width: 18ch;
  }
  .talks .lead {
    margin-bottom: 1.8rem;
    max-width: 48ch;
  }
  .talks__areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .talks__areas li {
    padding: 0.95rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  .talks__areas li:last-child {
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 880px) {
    .hero__inner,
    .series__pair,
    .host__inner,
    .talks__inner {
      grid-template-columns: 1fr;
    }
    .hero__media {
      order: -1;
      justify-self: start;
      width: min(220px, 60%);
    }
    .hero__title {
      max-width: none;
    }
    .host__portrait {
      width: min(200px, 60%);
    }
  }

  /* På smale skjermer legger vi handlingen under overskriften i stedet for at
     knappeteksten brekker i to linjer. */
  @media (max-width: 560px) {
    .row-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }
  }
</style>
