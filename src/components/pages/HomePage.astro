---
/**
 * Forsiden. Spørretimen som hele universet, med de to sporene under.
 *
 * Rekkefølgen er bevisst: først det nyeste på tvers av begge seriene, så
 * forklaringen av hva de to sporene er, så temaene. Økonomi er ett tema blant
 * flere her – det skal ikke prege forsiden mer enn de andre.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import Avatar from '@/components/Avatar.astro';
import { getEpisodes } from '@/lib/content';
import { site } from '@/data/site';
import { yrkestall } from '@/data/yrker';
import { path as routePath, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';

const episodes = await getEpisodes(lang);
const published = episodes.filter((e) => e.data.status === 'publisert');
const yrke = yrkestall();

// Én liste, ikke tre. Forsiden hadde «Nyeste», «Populært» og «Samtaler» ved
// siden av hverandre, og med et lite arkiv viste alle tre de samme kortene.
// Bare publiserte: overskriften sier «Siste episoder», og da skal det ikke
// ligge kommende episoder i lista. De står på /samtaler og /episoder.
// Seks er taket; blir det flere, ligger resten i arkivet.
const latest = published.slice(0, 6);

---

<BaseLayout lang={lang}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1 class="hero__title">
          {en ? (
            <>Good questions.<br />Interesting people.<br /><span class="hero__accent">New perspectives.</span></>
          ) : (
            <>Gode spørsmål.<br />Interessante mennesker.<br /><span class="hero__accent">Nye perspektiver.</span></>
          )}
        </h1>
        <p class="lead hero__lead">{t('site.description')}</p>
        <div class="hero__actions">
          <a class="btn" href={routePath(lang, 'conversations')}>Alle samtaler</a>
        </div>
      </div>

      <figure class="hero__media">
        <div class="hero__portrait">
          {/* Bildet er kvadratisk og har Spørretimen-merket inne i seg.
              Et annet forhold beskjærer sidene og kutter ordet. */}
          <Avatar
            name={site.host}
            src={site.hostImage}
            alt={en
              ? `${site.host}, host of Spørretimen`
              : `${site.host}, programleder i Spørretimen`}
            ratio="1 / 1"
          />
        </div>
        <figcaption class="hero__caption">
          <strong>{site.host}</strong>
          <span>{t('episode.host')}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Samtalene -->
  {
    latest.length > 0 && (
      <section class="section" aria-labelledby="latest-heading">
        <div class="container">
          <div class="row-head">
            <div>
              <p class="eyebrow">Samtalene</p>
              <h2 id="latest-heading">Siste episoder</h2>
            </div>
            <a class="btn btn-secondary btn-sm" href={routePath(lang, 'conversations')}>
              {en ? 'All conversations' : 'Alle samtaler'}
            </a>
          </div>
          <div class="grid grid-3">
            {latest.map((ep) => (
              <EpisodeCard lang={lang} episode={ep} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Yrkesjakten -->
  <section class="section yrkesjakt" aria-labelledby="yrker-heading">
    <div class="container">
      <div class="row-head">
        <div>
          <p class="eyebrow">{en ? 'Occupations' : 'Yrker'}</p>
          <h2 id="yrker-heading">
            {en ? 'Someone from every job there is' : 'Noen fra hvert eneste yrke'}
          </h2>
          <p class="lead">
            {en
              ? `${yrke.dekket} of ${yrke.totalt} occupations are done. The rest are open – and we are looking for them.`
              : `${yrke.dekket} av ${yrke.totalt} yrker er gjort. Resten er ledige – og vi leter etter dem.`}
          </p>
        </div>
        <a class="btn btn-secondary btn-sm" href={routePath(lang, 'occupations')}>
          {en ? 'See every occupation' : 'Se alle yrkene'}
        </a>
      </div>
    </div>
  </section>

  <!-- Jan Sindre -->

</BaseLayout>

<style>
  .yrkesjakt {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }
  .yrkesjakt .lead {
    margin-top: 0.6rem;
    max-width: 34rem;
  }

  /* Hero – rolig og redaksjonell. Ingen gradienter, ingen skjeve kort. */
  .hero {
    padding-block: clamp(3rem, 8vw, 6.5rem);
    border-bottom: 1px solid var(--line);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .hero__title {
    margin: 0 0 1.4rem;
    max-width: 15ch;
  }
  .hero__accent {
    font-style: italic;
    color: var(--ink-soft);
  }
  .hero__lead {
    max-width: 44ch;
    margin-bottom: 2.2rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
  }
  .hero__media {
    margin: 0;
    justify-self: end;
    width: min(380px, 100%);
  }
  .hero__portrait {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .hero__caption {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }
  .hero__caption strong {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
  }
  .hero__caption span {
    color: var(--ink-faint);
    font-size: 0.78rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  /* Seksjonshode med handling til høyre */
  .row-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.8rem, 3.5vw, 2.75rem);
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--line);
  }
  .row-head h2 {
    margin: 0;
  }
  .row-head .eyebrow {
    margin-bottom: 0.55rem;
  }

  /* To podkaster – ett univers. Samme kort, samme familie; det andre får
     bare en tynn markering i kanten så de leses som to. */

  /* Temaer – en tolinjers liste, ikke enda en kortvegg. */

  /* Hva vil du lære mer om? */

  /* Programlederen. Kort og saklig. */

  @media (max-width: 880px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__media {
      order: -1;
      justify-self: start;
      width: min(220px, 60%);
    }
    .hero__title {
      max-width: none;
    }
  }

  /* På smale skjermer legger vi handlingen under overskriften i stedet for at
     knappeteksten brekker i to linjer. */
  @media (max-width: 560px) {
    .row-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }
  }
</style>
