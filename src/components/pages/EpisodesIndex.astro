---
/**
 * Hele arkivet, på tvers av begge seriene. Adressen /episoder/ er uendret,
 * så det som allerede er indeksert består.
 */
import ContentIndex from './ContentIndex.astro';
import { getEpisodes } from '@/lib/content';
import { type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';
const episodes = await getEpisodes(lang);
---

<ContentIndex
  lang={lang}
  episodes={episodes}
  eyebrow={en ? 'Episodes' : 'Episoder'}
  title={t('episode.allEpisodes')}
  lead={en
    ? 'Everything from both series in one place – conversations, explainers, short primers and books. Filter by format or topic, or search.'
    : 'Alt fra begge seriene på ett sted – samtaler, Lær noe nytt, Kort forklart og bøker. Filtrer på format eller tema, eller søk.'}
  metaDescription={en
    ? 'Every episode of Spørretimen and Spørretimen Explained – conversations, explainers, short primers and books explained. Filter by format and topic.'
    : 'Alle episoder av Spørretimen og Spørretimen Forklart – samtaler, Lær noe nytt, Kort forklart og bøker forklart. Filtrer på format og tema.'}
/>
