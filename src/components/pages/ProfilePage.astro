---
/**
 * /jan-sindre-heltne – programlederens profilside.
 *
 * Alt som står om bakgrunn her er hentet fra det som allerede sto på
 * Om-siden. Ingen titler, ingen «ekspert». Profilen bygges av det som faktisk
 * er publisert – derfor er nyeste innhold og temaene det meste av siden.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Avatar from '@/components/Avatar.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import { getEpisodes, getSeriesEpisodes } from '@/lib/content';
import { site, socialsFor, canonicalUrl, absoluteUrl, breadcrumbList } from '@/data/site';
import { entryPath, path as routePath, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import { seriesById } from '@/i18n/taxonomy';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const en = lang === 'en';

const episodes = await getEpisodes(lang);
const published = episodes.filter((e) => e.data.status === 'publisert');
const profilLenker = socialsFor(lang);
const sameAs = profilLenker.map((s) => s.url!);

const here = routePath(lang, 'profile');

const person = {
  '@type': 'Person',
  '@id': `${canonicalUrl(here)}#person`,
  name: site.host,
  url: canonicalUrl(here),
  image: absoluteUrl(site.hostImage),
  jobTitle: 'Programleder i Spørretimen',
  description:
    'Programleder i Spørretimen, en samtalepodkast om folk og jobbene deres. Siviløkonom med master i logistikk og bakgrunn fra ERP. Jobber til daglig med Business Analytics og står i front i selskapets AI-utvikling, med AI-agenter og automatiseringer i Power Apps og Power Automate. Podkasten lages på fritiden.',
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'degree',
      name: en ? 'Siviløkonom (MSc in Business)' : 'Siviløkonom',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'degree',
      name: en ? 'Master in logistics' : 'Master i logistikk',
    },
  ],
  sameAs,
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: canonicalUrl(here),
    dateModified: new Date().toISOString().slice(0, 10),
    mainEntity: person,
  },
  breadcrumbList([
    { name: en ? 'Home' : 'Forsiden', path: routePath(lang, 'home') },
    { name: site.host, path: here },
  ]),
];
---

<BaseLayout
  lang={lang}
  title={site.host}
  description={person.description}
  image={site.hostImage}
  imageAlt={site.host}
  type="profile"
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow={en ? 'Profile' : 'Profil'}
    title={site.host}
    lead="Programleder i Spørretimen. Han snakker med folk om jobbene deres – hvordan arbeidsdagen faktisk ser ut, hva som førte dem dit, og hva de har lært underveis."
  />

  <section class="section">
    <div class="container profile">
      <aside class="profile__side">
        <div class="profile__portrait">
          <Avatar
            name={site.host}
            src={site.hostImage}
            alt={en ? `${site.host}, host of Spørretimen` : `${site.host}, programleder i Spørretimen`}
            ratio="1 / 1"
          />
        </div>
        <dl class="profile__facts">
          <dt>{en ? 'Role' : 'Rolle'}</dt>
          <dd>{en ? 'Host, Spørretimen' : 'Programleder i Spørretimen'}</dd>
          <dt>{en ? 'Education' : 'Utdanning'}</dt>
          <dd>
            {en ? 'Siviløkonom (MSc in Business), ' : 'Siviløkonom, '}
            {en ? 'master’s in logistics' : 'master i logistikk'}
          </dd>
          <dt>{en ? 'Theses' : 'Oppgaver'}</dt>
          <dd>
            {en ? 'Bachelor thesis on RFID and stock counting' : 'Bacheloroppgave om RFID og varetelling'}{' · '}
            {en ? 'Master’s thesis on ERP–WMS integrations' : 'Masteroppgave om ERP–WMS-integrasjoner'}
          </dd>
          <dt>{en ? 'Background' : 'Bakgrunn'}</dt>
          <dd>ERP</dd>
          <dt>{en ? 'Works with' : 'Jobber med'}</dt>
          <dd>Business Analytics, AI-agenter og automatisering i Power Apps og Power Automate</dd>
          <dt>{en ? 'Based in' : 'Tilknytning'}</dt>
          <dd>{en ? 'Sunnmøre, Norway' : 'Sunnmøre'}</dd>
        </dl>
        {
          sameAs.length > 0 && (
            <ul class="profile__links">
              {profilLenker
                .map((s) => (
                  <li>
                    <a href={s.url!} target="_blank" rel="noopener me">{s.label}</a>
                  </li>
                ))}
            </ul>
          )
        }
      </aside>

      <div class="profile__main prose">
        <p>
          Jan Sindre Heltne startet Spørretimen ut fra en enkel idé: mange mennesker
          sitter på historier, erfaringer og kunnskap som flere burde få høre. Samtalene
          handler om hvordan det egentlig er å ha en jobb – hva man gjør i løpet av en
          dag, hva som førte en dit, hva som er vanskelig, og hva ingen fortalte på
          forhånd.
        </p>
        <p>
          Målet er å snakke med noen fra hvert eneste yrke som finnes. Det kommer til å
          ta tid, og lista over yrker som står igjen er lang. Den ligger åpent på
          nettstedet, så hvem som helst kan tipse om noen.
        </p>
        <p>
          Han er siviløkonom med master i logistikk og har bakgrunn fra ERP. Bachelor- og
          masteroppgaven handlet om RFID og varetelling, og om integrasjoner mellom ERP og
          WMS. Til daglig jobber han med Business Analytics, og står i front i selskapets
          arbeid med kunstig intelligens: han utvikler AI-agenter og bygger
          automatiseringer i Power Apps og Power Automate som tar bort manuelle steg og
          effektiviserer arbeidsdagen for andre. Podkasten er hobby, og lages på fritiden
          – den har ingen sammenheng med arbeidsgiveren hans. Skulle en episode en gang ha
          det, blir det merket og forklart i episoden.
        </p>
        <p>
          Han fremstilles ikke som ekspert på det gjestene jobber med. Det er gjestene som
          kan faget; han stiller spørsmålene. Nettstedet skiller tydelig mellom personlig
          erfaring og dokumenterte fakta, og der noe er usikkert, sier episoden det. Det er
          hele tilnærmingen: nysgjerrig, ikke belærende.
        </p>
      </div>
    </div>
  </section>



  <section class="section cta">
    <div class="container container-narrow text-center">
      <h2>{en ? 'The conversations, and contact' : 'Samtalene, og kontakt'}</h2>
      <div class="cta__actions">
        <a class="btn" href={routePath(lang, 'conversations')}>{en ? 'The conversations' : 'Samtalene'}</a>
        <a class="btn btn-ghost" href={routePath(lang, 'contact')} data-track="contact_click" data-track-label="profile">
          {en ? 'Contact →' : 'Kontakt →'}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .profile {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .profile__portrait {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .profile__facts {
    margin: 1.4rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .profile__facts dt {
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .profile__facts dd {
    margin: 0.25rem 0 0.85rem;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .profile__links {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.88rem;
  }
  .profile__links a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }
  .profile__links a:hover {
    color: var(--accent-strong);
    border-color: var(--accent);
  }
  .profile__main {
    max-width: none;
  }

  .row-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.8rem, 3.5vw, 2.75rem);
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--line);
  }
  .row-head h2 {
    margin: 0;
  }
  .row-head .eyebrow {
    margin-bottom: 0.55rem;
  }
  .cta {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 1.8rem;
  }

  @media (max-width: 800px) {
    .profile {
      grid-template-columns: 1fr;
    }
    .profile__portrait {
      width: min(240px, 70%);
    }
  }
  @media (max-width: 560px) {
    .row-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }
  }
</style>
