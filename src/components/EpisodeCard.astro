---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Cover from './Cover.astro';
import { formatById } from '@/data/site';
import { formatDate, formatReleaseShort } from '@/lib/utils';

interface Props {
  episode: CollectionEntry<'episodes'>;
}
const { episode } = Astro.props;
const d = episode.data;
const format = formatById(d.format);
const guest = d.guest ? await getEntry(d.guest) : undefined;
const dateLabel =
  d.status === 'kommende' ? formatReleaseShort(d.publishDate) : formatDate(d.publishDate);
---

<article class:list={['card', 'ep', { 'ep--kommende': d.status === 'kommende' }]}>
  <a class="ep__cover-link" href={`/episoder/${episode.id}/`} tabindex="-1" aria-hidden="true">
    <Cover title={d.title} src={d.image} alt={d.imageAlt} format={d.format} />
  </a>
  <div class="ep__body">
    <div class="ep__meta">
      <span class:list={['tag', `tag-${d.format}`]}>{format?.singular}</span>
      {d.status === 'kommende' && <span class="tag tag-status">Kommende</span>}
    </div>
    {d.yrke && <p class="ep__career">Karriere · {d.yrke}</p>}
    <h3 class="ep__title">
      <a href={`/episoder/${episode.id}/`}>{d.title}</a>
    </h3>
    {
      guest && (
        <p class="ep__guest">
          Med {guest.data.name}
          {!d.yrke && ` · ${guest.data.role}`}
        </p>
      )
    }
    <p class="ep__desc">{d.description}</p>
    <div class="ep__foot">
      {d.duration && <span>{d.duration}</span>}
      {d.duration && dateLabel && <span aria-hidden="true">·</span>}
      {dateLabel && <span>{dateLabel}</span>}
    </div>
  </div>
</article>

<style>
  .ep {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .ep__cover-link {
    display: block;
    position: relative;
  }
  /* Omslaget ligger dempet i grunnvisningen og får full farge når kortet
     får oppmerksomhet. Se --img-grade i global.css. */
  .ep:hover .ep__cover-link :global(.cover img),
  .ep:focus-within .ep__cover-link :global(.cover img) {
    filter: none;
  }
  .ep:hover .ep__cover-link :global(.cover)::after,
  .ep:focus-within .ep__cover-link :global(.cover)::after {
    opacity: 0;
  }

  /* Kommende episoder dempes visuelt, så publiserte episoder trer tydeligere
     frem. Teksten holdes fullt lesbar – kun omslaget tones ned. */
  .ep--kommende .ep__cover-link :global(.cover) {
    filter: saturate(0.55) brightness(0.82);
    transition: filter 0.25s ease;
  }
  .ep--kommende .ep__cover-link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--paper) 38%, transparent);
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  /* Full farge når kortet får oppmerksomhet */
  .ep--kommende:hover .ep__cover-link :global(.cover),
  .ep--kommende:focus-within .ep__cover-link :global(.cover) {
    filter: none;
  }
  .ep--kommende:hover .ep__cover-link::after,
  .ep--kommende:focus-within .ep__cover-link::after {
    opacity: 0;
  }
  .ep--kommende .ep__title a {
    color: var(--ink-soft);
  }
  .ep--kommende:hover .ep__title a {
    color: var(--accent-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .ep--kommende .ep__cover-link :global(.cover),
    .ep--kommende .ep__cover-link::after {
      transition: none;
    }
  }
  .ep__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.35rem 1.4rem 1.5rem;
    flex: 1;
  }
  .ep__meta {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .ep__career {
    margin: 0.15rem 0 -0.2rem;
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .ep__title {
    font-size: 1.28rem;
    margin: 0.15rem 0 0;
    line-height: 1.24;
    letter-spacing: -0.014em;
    text-wrap: pretty;
  }
  .ep__title a {
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .ep__title a:hover {
    color: var(--accent-strong);
  }
  .ep__guest {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .ep__desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.93rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ep__foot {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    gap: 0.45rem;
    align-items: center;
    color: var(--ink-faint);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
  }
</style>
