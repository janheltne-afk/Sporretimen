---
import { supabase } from '@/data/supabase';

/**
 * Kommentarfelt for en episode. Navn er påkrevd.
 * Kommentarer vises umiddelbart, men kan skjules eller slettes av redaksjonen
 * i Supabase-dashboardet (feltet `is_hidden`).
 */
import { path, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang?: Locale;
  /**
   * Episoden kommentarene hører til. Bruk grunnslugen uten språkprefiks, slik at
   * den norske og den engelske utgaven av samme episode deler kommentarfelt.
   */
  slug: string;
}
const { lang = 'no', slug } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="kommentarer"
  aria-labelledby="kommentar-heading"
  data-slug={slug}
  data-url={supabase.url}
  data-key={supabase.key}
  data-empty={t('comments.empty')}
  data-load-failed={t('comments.loadFailed')}
  data-send-failed={t('comments.sendFailed')}
  data-thanks={t('comments.thanks')}
  data-invalid={t('comments.invalid')}
  data-sending={t('form.sending')}
  data-locale={lang === 'en' ? 'en-GB' : 'nb-NO'}
>
  <h2 id="kommentar-heading">{t('comments.heading')}</h2>
  <p class="kommentarer__intro muted">{t('comments.intro')}</p>

  <form class="kommentarer__form card" novalidate>
    <div class="field--row">
      <div class="field">
        <label for="k-navn">{t('comments.name')} <span class="req">*</span></label>
        <input id="k-navn" name="navn" type="text" required maxlength="60" autocomplete="name" />
      </div>
    </div>
    <div class="field">
      <label for="k-tekst">{t('comments.body')} <span class="req">*</span></label>
      <textarea id="k-tekst" name="tekst" required maxlength="2000" rows="4"></textarea>
    </div>
    <!-- Enkel spam-felle -->
    <div class="kommentarer__hp" aria-hidden="true">
      <label>{t('form.honeypot')}<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="kommentarer__foot">
      <button type="submit" class="btn">{t('comments.send')}</button>
      <p class="kommentarer__status" role="status" aria-live="polite"></p>
    </div>
    <p class="kommentarer__consent muted">
      {t('comments.consent')}{' '}
      <a href={path(lang, 'privacy')}>{t('comments.consentLink')}</a>.
    </p>
  </form>

  <div class="kommentarer__list" data-role="list">
    <p class="muted">{t('comments.loading')}</p>
  </div>

  <p class="kommentarer__note muted">{t('comments.moderation')}</p>
</section>

<style>
  .kommentarer {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .kommentarer h2 {
    margin-bottom: 0.4rem;
  }
  .kommentarer__intro {
    margin: 0 0 1.6rem;
    font-size: 0.92rem;
  }
  .kommentarer__form {
    padding: clamp(1.4rem, 3vw, 1.9rem);
    display: grid;
    gap: 1.1rem;
  }
  .kommentarer .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .kommentarer label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .kommentarer input[type='text'],
  .kommentarer textarea {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    transition: border-color 0.2s ease;
  }
  .kommentarer textarea {
    resize: vertical;
    min-height: 120px;
  }
  .kommentarer input:focus,
  .kommentarer textarea:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: none;
  }
  .kommentarer input[aria-invalid='true'],
  .kommentarer textarea[aria-invalid='true'] {
    border-color: #c0392b;
  }
  .req {
    color: var(--accent-strong);
  }
  .kommentarer__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .kommentarer__foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .kommentarer__status {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .kommentarer__status.is-error {
    color: #c0392b;
  }
  .kommentarer__status.is-success {
    color: var(--tag-samtale);
    font-weight: 600;
  }
  .kommentarer__consent {
    margin: 0;
    font-size: 0.82rem;
  }
  .kommentarer__consent a {
    color: inherit;
    text-decoration: underline;
  }
  .kommentarer__list {
    margin-top: 1.8rem;
    display: grid;
    gap: 1rem;
  }
  .kommentar {
    padding: 1.3rem 1.45rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .kommentar__head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .kommentar__name {
    font-weight: 500;
    font-family: var(--font-display);
    font-size: 1.08rem;
  }
  .kommentar__date {
    font-size: 0.82rem;
    color: var(--ink-faint);
  }
  .kommentar__body {
    margin: 0;
    color: var(--ink-soft);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .kommentarer__note {
    margin-top: 1.6rem;
    font-size: 0.85rem;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.kommentarer');
  if (root) {
    const slug = root.dataset.slug!;
    const url = root.dataset.url!;
    const key = root.dataset.key!;
    const form = root.querySelector<HTMLFormElement>('form')!;
    const list = root.querySelector<HTMLElement>('[data-role="list"]')!;
    const status = root.querySelector<HTMLElement>('.kommentarer__status')!;
    const headers = { apikey: key, Authorization: `Bearer ${key}` };

    const setStatus = (msg: string, kind: '' | 'error' | 'success' = '') => {
      status.textContent = msg;
      status.className = 'kommentarer__status' + (kind ? ` is-${kind}` : '');
    };

    const dateFmt = new Intl.DateTimeFormat(root.dataset.locale!, {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });

    /** Setter tekst trygt (unngår HTML-injeksjon fra kommentarer). */
    function render(rows: { author_name: string; body: string; created_at: string }[]) {
      list.textContent = '';
      if (!rows.length) {
        const p = document.createElement('p');
        p.className = 'muted';
        p.textContent = root!.dataset.empty!;
        list.append(p);
        return;
      }
      for (const row of rows) {
        const art = document.createElement('article');
        art.className = 'kommentar';

        const head = document.createElement('div');
        head.className = 'kommentar__head';

        const name = document.createElement('span');
        name.className = 'kommentar__name';
        name.textContent = row.author_name;

        const date = document.createElement('span');
        date.className = 'kommentar__date';
        date.textContent = dateFmt.format(new Date(row.created_at));

        head.append(name, date);

        const body = document.createElement('p');
        body.className = 'kommentar__body';
        body.textContent = row.body;

        art.append(head, body);
        list.append(art);
      }
    }

    async function load() {
      try {
        const res = await fetch(
          `${url}/rest/v1/comments?episode_slug=eq.${encodeURIComponent(slug)}` +
            `&select=author_name,body,created_at&order=created_at.desc&limit=200`,
          { headers }
        );
        render(await res.json());
      } catch {
        list.textContent = '';
        const p = document.createElement('p');
        p.className = 'muted';
        p.textContent = root!.dataset.loadFailed!;
        list.append(p);
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const hp = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
      if (hp?.value) return;

      const navn = form.querySelector<HTMLInputElement>('#k-navn')!;
      const tekst = form.querySelector<HTMLTextAreaElement>('#k-tekst')!;
      let ok = true;
      for (const el of [navn, tekst]) {
        const valid = el.value.trim().length >= 2;
        el.setAttribute('aria-invalid', valid ? 'false' : 'true');
        if (!valid && ok) {
          el.focus();
          ok = false;
        }
      }
      if (!ok) {
        setStatus(root.dataset.invalid!, 'error');
        return;
      }

      setStatus(root.dataset.sending!);
      try {
        const res = await fetch(`${url}/rest/v1/comments`, {
          method: 'POST',
          headers: { ...headers, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify({
            episode_slug: slug,
            author_name: navn.value.trim(),
            body: tekst.value.trim(),
          }),
        });
        if (!res.ok) throw new Error('feil');
        tekst.value = '';
        setStatus(root.dataset.thanks!, 'success');
        await load();
      } catch {
        setStatus(root.dataset.sendFailed!, 'error');
      }
    });

    load();
  }
</script>
