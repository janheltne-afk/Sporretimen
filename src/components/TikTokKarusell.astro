---
/**
 * Videokarusell for TikTok-klippene.
 *
 * Videoene blir liggende hos TikTok. Kortet som vises først er vårt eget –
 * et lokalt plakatbilde eller et typografisk kort – og TikToks spiller lastes
 * ikke før noen trykker på play. Før det går det ikke én forespørsel til
 * tiktok.com, og det settes ingen informasjonskapsler.
 *
 * Spilleren er TikToks offisielle iframe (player/v1). Vi bruker den framfor
 * blockquote + embed.js fordi den lar seg styre med postMessage: da kan vi
 * stoppe en video når brukeren blar videre, og fange opp at en video er
 * fjernet. Den krever heller ikke at vi laster inn TikToks skript på siden.
 *
 * Fargene er Spørretimens videopalett (merkevare/tokens.json → farger.forside),
 * ikke den lyse nettsidepaletten. Seksjonen er med vilje en mørk stripe.
 *
 * Videoene redigeres i src/data/tiktok.ts. Denne fila skal ikke endres for å
 * legge til, fjerne eller omrokere en video.
 */
import { playableVideos, tiktokCategories, tiktokProfileUrl, tiktokHandle, usedCategories } from '@/data/tiktok';
import type { Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
  /** Overskriften over karusellen. */
  title?: string;
  lead?: string;
}

const { lang, title, lead } = Astro.props;
const en = lang === 'en';

const videos = playableVideos();
const kategorier = usedCategories(videos);
const visFilter = kategorier.length > 1;

const tekst = {
  tittel: title ?? (en ? 'Short clips' : 'Korte klipp'),
  ingress:
    lead ??
    (en
      ? 'One question, one answer, under a minute. The clips play here; the videos stay on TikTok.'
      : 'Ett spørsmål, ett svar, under minuttet. Klippene spilles av her; videoene ligger hos TikTok.'),
  alle: en ? 'All videos' : 'Alle videoer',
  filterGruppe: en ? 'Filter videos by category' : 'Filtrer videoer på kategori',
  karusell: en ? 'Video carousel' : 'Videokarusell',
  forrige: en ? 'Previous videos' : 'Forrige videoer',
  neste: en ? 'Next videos' : 'Neste videoer',
  spill: en ? 'Play' : 'Spill av',
  laster: en ? 'Loading from TikTok…' : 'Laster fra TikTok …',
  utilgjengelig: en ? 'This video is no longer available' : 'Denne videoen er ikke tilgjengelig lenger',
  apneTikTok: en ? 'Open on TikTok' : 'Åpne på TikTok',
  seAlle: en ? `See all on TikTok` : 'Se alle på TikTok',
  personvern: en
    ? 'Pressing play loads the video from TikTok. TikTok may then set cookies and register your visit.'
    : 'Trykker du på play, lastes videoen fra TikTok. TikTok kan da sette informasjonskapsler og registrere besøket.',
  tomt: en ? 'No videos yet.' : 'Ingen videoer ennå.',
};

const etikett = (id: string) =>
  tiktokCategories.find((c) => c.id === id)?.label[lang] ?? id;
---

{
  videos.length > 0 && (
    <section class="tk section" aria-labelledby="tk-tittel" data-tiktok-karusell>
      <div class="container">
        <header class="tk__topp">
          <p class="tk__merke">TikTok</p>
          <h2 id="tk-tittel">{tekst.tittel}</h2>
          <p class="tk__ingress">{tekst.ingress}</p>
        </header>

        {visFilter && (
          <div class="tk__filtre" role="group" aria-label={tekst.filterGruppe}>
            <button type="button" class="tk__filter" data-filter="alle" aria-pressed="true">
              {tekst.alle}
            </button>
            {kategorier.map((id) => (
              <button type="button" class="tk__filter" data-filter={id} aria-pressed="false">
                {etikett(id)}
              </button>
            ))}
          </div>
        )}

        <div class="tk__ramme">
          <button type="button" class="tk__pil tk__pil--forrige" data-pil="forrige" aria-label={tekst.forrige}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <ul class="tk__spor" data-spor aria-label={tekst.karusell}>
            {videos.map((video) => (
              <li class="tk__celle" data-kort data-kategori={video.category} data-video-id={video.videoId}>
                <article class="tk__kort">
                  <div class="tk__flate">
                    <button
                      type="button"
                      class="tk__plakat"
                      data-spill
                      aria-label={`${tekst.spill}: ${video.title[lang]}`}
                    >
                      {video.thumbnail ? (
                        <img
                          class="tk__bilde"
                          src={video.thumbnail}
                          alt=""
                          width="320"
                          height="569"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        /* Uten plakatbilde: et merkekort. Tittelen står under
                           kortet, så den gjentas ikke her. */
                        <span class="tk__typo" aria-hidden="true">
                          <span class="tk__typo-tegn">?</span>
                        </span>
                      )}
                      <span class="tk__slor" aria-hidden="true" />
                      <span class="tk__play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                          <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                        </svg>
                      </span>
                    </button>
                    <div class="tk__feil" data-feil hidden>
                      <p>{tekst.utilgjengelig}</p>
                      <a href={video.tiktokUrl} rel="noopener noreferrer" target="_blank">
                        {tekst.apneTikTok}
                      </a>
                    </div>
                  </div>
                  <h3 class="tk__tittel">
                    <a href={video.tiktokUrl} rel="noopener noreferrer" target="_blank">
                      {video.title[lang]}
                    </a>
                  </h3>
                  <p class="tk__kategori">{etikett(video.category)}</p>
                </article>
              </li>
            ))}
          </ul>

          <button type="button" class="tk__pil tk__pil--neste" data-pil="neste" aria-label={tekst.neste}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>

        <p class="tk__tomt" data-tomt hidden>{tekst.tomt}</p>

        <footer class="tk__bunn">
          <p class="tk__personvern">{tekst.personvern}</p>
          <a class="tk__lenke" href={tiktokProfileUrl} rel="me noopener noreferrer" target="_blank">
            {tekst.seAlle}{' '}
            <span class="tk__handle">@{tiktokHandle}</span>
          </a>
        </footer>
      </div>
    </section>
  )
}

<style>
  /* Videopaletten, ikke nettsidepaletten. Seksjonen er en mørk stripe. */
  .tk {
    --tk-grunn: #100e0b;
    --tk-krem: #ece6d6;
    --tk-gull: #e2cb96;
    --tk-dempet: #baa376;
    --tk-strek: #967e58;
    --tk-linje: #2b2621;
    --tk-flate: #17130f;
    --tk-kort: 320px;

    background: var(--tk-grunn);
    color: var(--tk-krem);
  }

  .tk__topp {
    max-width: 44rem;
  }
  .tk__merke {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tk-strek);
    margin-bottom: 0.75rem;
  }
  .tk h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    color: var(--tk-krem);
    margin: 0;
  }
  .tk__ingress {
    margin-top: 0.75rem;
    color: var(--tk-dempet);
    max-width: 38rem;
  }

  /* Filterknapper – samme formspråk som filtrene ellers på nettstedet */
  .tk__filtre {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .tk__filter {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--tk-linje);
    border-radius: var(--radius);
    background: transparent;
    color: var(--tk-dempet);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .tk__filter:hover {
    color: var(--tk-krem);
    border-color: var(--tk-strek);
  }
  .tk__filter[aria-pressed='true'] {
    color: var(--tk-grunn);
    background: var(--tk-gull);
    border-color: var(--tk-gull);
  }
  .tk__filter:focus-visible,
  .tk__pil:focus-visible,
  .tk__plakat:focus-visible {
    outline: 2px solid var(--tk-gull);
    outline-offset: 2px;
  }

  /* Karusellen */
  .tk__ramme {
    position: relative;
    margin-top: 1.75rem;
  }

  .tk__spor {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* Kortene skal kunne rulle helt ut til kanten på mobil. */
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  .tk__spor::-webkit-scrollbar {
    display: none;
  }

  .tk__celle {
    flex: 0 0 var(--tk-kort);
    scroll-snap-align: start;
    display: flex;
  }
  /* Kategorilinjene skal stå på samme høyde selv om titlene er ulikt lange. */
  .tk__kort {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .tk__celle[hidden] {
    display: none;
  }

  /* Fast 9:16-boks. Hindrer at noe hopper når spilleren byttes inn. */
  .tk__flate {
    position: relative;
    aspect-ratio: 9 / 16;
    background: var(--tk-flate);
    border: 1px solid var(--tk-linje);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .tk__flate :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .tk__plakat {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: block;
  }
  .tk__bilde {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.85) contrast(0.98);
  }
  /* Kort uten plakatbilde: tittelen satt i display-skriften. */
  .tk__typo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(90% 60% at 50% 12%, rgba(201, 141, 78, 0.16) 0%, rgba(16, 14, 11, 0) 70%),
      linear-gradient(180deg, #1b1712 0%, #100e0b 100%);
  }
  .tk__typo-tegn {
    font-family: var(--font-display);
    font-size: 7rem;
    line-height: 1;
    color: var(--tk-strek);
    opacity: 0.45;
    transform: translateY(-1.5em);
  }
  .tk__slor {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 9, 7, 0) 45%, rgba(10, 9, 7, 0.55) 100%);
  }
  .tk__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(236, 230, 214, 0.5);
    background: rgba(16, 14, 11, 0.55);
    color: var(--tk-krem);
    backdrop-filter: blur(2px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .tk__play svg {
    width: 26px;
    height: 26px;
  }
  .tk__plakat:hover .tk__play {
    background: rgba(226, 203, 150, 0.9);
    border-color: var(--tk-gull);
    color: var(--tk-grunn);
  }

  .tk__feil {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    background: var(--tk-flate);
    color: var(--tk-dempet);
    font-size: 0.95rem;
  }
  .tk__feil a {
    color: var(--tk-gull);
  }
  /* `display: grid` over slår nettleserens egen [hidden]-regel. Uten denne
     ligger feilboksen usynlig oppå plakaten og spiser klikkene. */
  .tk__feil[hidden] {
    display: none;
  }

  .tk__tittel {
    margin: 0.9rem 0 auto;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .tk__tittel a {
    color: var(--tk-krem);
    text-decoration: none;
  }
  .tk__tittel a:hover {
    color: var(--tk-gull);
  }
  .tk__kategori {
    margin: 0.35rem 0 0;
    padding-top: 0.15rem;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tk-strek);
  }

  /* Piler – bare på pekerenheter med plass. */
  .tk__pil {
    position: absolute;
    top: calc((var(--tk-kort) * 16 / 9) / 2);
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    display: none;
    place-items: center;
    border: 1px solid var(--tk-linje);
    border-radius: 50%;
    background: rgba(16, 14, 11, 0.86);
    color: var(--tk-krem);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }
  .tk__pil svg {
    width: 22px;
    height: 22px;
  }
  .tk__pil:hover {
    color: var(--tk-gull);
    border-color: var(--tk-strek);
  }
  .tk__pil[disabled] {
    opacity: 0.3;
    cursor: default;
  }
  .tk__pil--forrige {
    left: calc(var(--gutter) * -1 - 10px);
  }
  .tk__pil--neste {
    right: calc(var(--gutter) * -1 - 10px);
  }
  @media (min-width: 900px) {
    .tk__pil {
      display: grid;
    }
  }

  .tk__tomt {
    margin-top: 1.5rem;
    color: var(--tk-dempet);
  }

  .tk__bunn {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--tk-linje);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: baseline;
    justify-content: space-between;
  }
  .tk__personvern {
    margin: 0;
    font-size: 0.85rem;
    color: var(--tk-strek);
    max-width: 44rem;
  }
  .tk__lenke {
    color: var(--tk-gull);
    text-decoration: none;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .tk__lenke:hover {
    text-decoration: underline;
  }
  .tk__handle {
    color: var(--tk-strek);
  }

  @media (max-width: 720px) {
    .tk {
      /* Én hovedvideo, med neste så vidt synlig. */
      --tk-kort: min(78vw, 300px);
    }
    .tk__bunn {
      display: block;
    }
    .tk__lenke {
      display: inline-block;
      margin-top: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tk__spor {
      scroll-behavior: auto;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tk__spor {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  /**
   * Karusellen. Ingen avhengigheter – scroll-snap gjør rullingen, og
   * TikToks spiller styres med postMessage slik den offisielle
   * dokumentasjonen beskriver.
   */
  const TIKTOK_ORIGIN = 'https://www.tiktok.com';

  type Melding = { 'x-tiktok-player': boolean; type: string; value?: unknown };

  function send(ramme: HTMLIFrameElement, type: string, value?: unknown) {
    const melding: Melding = { 'x-tiktok-player': true, type, value };
    ramme.contentWindow?.postMessage(melding, TIKTOK_ORIGIN);
  }

  function start(rot: HTMLElement) {
    const spor = rot.querySelector<HTMLElement>('[data-spor]');
    const tomt = rot.querySelector<HTMLElement>('[data-tomt]');
    if (!spor) return;

    const celler = Array.from(rot.querySelectorAll<HTMLElement>('[data-kort]'));
    const filtre = Array.from(rot.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const piler = Array.from(rot.querySelectorAll<HTMLButtonElement>('[data-pil]'));

    /* ── Avspilling ─────────────────────────────────────────────────────── */

    /** Stopper alle spillere unntatt den vi eventuelt skåner. */
    function stoppAndre(unntak?: HTMLElement) {
      for (const celle of celler) {
        if (celle === unntak) continue;
        const ramme = celle.querySelector('iframe');
        if (ramme) send(ramme, 'pause');
      }
    }

    function aktiver(celle: HTMLElement) {
      if (celle.dataset.aktiv === 'ja') return;
      const videoId = celle.dataset.videoId;
      const flate = celle.querySelector<HTMLElement>('.tk__flate');
      const plakat = celle.querySelector<HTMLElement>('[data-spill]');
      if (!videoId || !flate || !plakat) return;

      celle.dataset.aktiv = 'ja';
      stoppAndre(celle);

      const params = new URLSearchParams({
        autoplay: '1',
        music_info: '0',
        description: '0',
        rel: '0',
        native_context_menu: '0',
      });
      const ramme = document.createElement('iframe');
      ramme.src = `${TIKTOK_ORIGIN}/player/v1/${videoId}?${params}`;
      ramme.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
      ramme.referrerPolicy = 'strict-origin-when-cross-origin';
      ramme.loading = 'lazy';
      ramme.title = plakat.getAttribute('aria-label') ?? 'TikTok';
      flate.appendChild(ramme);
      plakat.remove();
    }

    function visFeil(celle: HTMLElement) {
      celle.querySelector('iframe')?.remove();
      celle.querySelector<HTMLElement>('[data-spill]')?.remove();
      const feil = celle.querySelector<HTMLElement>('[data-feil]');
      if (feil) feil.hidden = false;
    }

    for (const celle of celler) {
      celle.querySelector('[data-spill]')?.addEventListener('click', () => aktiver(celle));
    }

    /* Meldinger fra spilleren: fang opp videoer som er borte. */
    window.addEventListener('message', (e: MessageEvent) => {
      if (e.origin !== TIKTOK_ORIGIN) return;
      const data = e.data as { type?: string; value?: { errorCode?: number } } | null;
      if (!data || typeof data !== 'object' || data.type !== 'onPlayerError') return;
      const kode = data.value?.errorCode;
      if (kode !== 1001 && kode !== 2001) return;
      const celle = celler.find((c) => c.querySelector('iframe')?.contentWindow === e.source);
      if (celle) visFeil(celle);
    });

    /* Ruller en video ut av syne, stopper den. */
    if ('IntersectionObserver' in window) {
      const vakt = new IntersectionObserver(
        (poster) => {
          for (const post of poster) {
            if (post.isIntersecting) continue;
            const ramme = post.target.querySelector('iframe');
            if (ramme) send(ramme, 'pause');
          }
        },
        { root: spor, threshold: 0.4 },
      );
      for (const celle of celler) vakt.observe(celle);
    }

    /* ── Filtrering ─────────────────────────────────────────────────────── */

    function filtrer(valgt: string) {
      let synlige = 0;
      for (const celle of celler) {
        const treff = valgt === 'alle' || celle.dataset.kategori === valgt;
        celle.hidden = !treff;
        if (treff) synlige++;
        else {
          const ramme = celle.querySelector('iframe');
          if (ramme) send(ramme, 'pause');
        }
      }
      for (const knapp of filtre) {
        knapp.setAttribute('aria-pressed', String(knapp.dataset.filter === valgt));
      }
      if (tomt) tomt.hidden = synlige > 0;
      spor.scrollTo({ left: 0 });
      oppdaterPiler();
    }

    for (const knapp of filtre) {
      knapp.addEventListener('click', () => filtrer(knapp.dataset.filter ?? 'alle'));
    }

    /* ── Piler ──────────────────────────────────────────────────────────── */

    function steg() {
      const celle = celler.find((c) => !c.hidden);
      const bredde = celle ? celle.getBoundingClientRect().width + 20 : 340;
      return Math.max(bredde, Math.floor(spor.clientWidth / bredde) * bredde);
    }

    function oppdaterPiler() {
      const maks = spor.scrollWidth - spor.clientWidth - 1;
      for (const pil of piler) {
        const forrige = pil.dataset.pil === 'forrige';
        pil.disabled = forrige ? spor.scrollLeft <= 0 : spor.scrollLeft >= maks;
      }
    }

    for (const pil of piler) {
      pil.addEventListener('click', () => {
        const retning = pil.dataset.pil === 'forrige' ? -1 : 1;
        spor.scrollBy({ left: retning * steg() });
      });
    }

    spor.addEventListener('scroll', oppdaterPiler, { passive: true });
    window.addEventListener('resize', oppdaterPiler, { passive: true });
    oppdaterPiler();
  }

  for (const rot of document.querySelectorAll<HTMLElement>('[data-tiktok-karusell]')) start(rot);
</script>
