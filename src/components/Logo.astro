---
/**
 * Spørretimen-ordmerke.
 *
 * Rent typografisk: navnet i sperrede versaler, uten ikon eller symbol.
 * `sub` legger til en dempet undertittel under navnet – brukes i toppen,
 * ikke i bunnteksten der undertittelen allerede står som egen linje.
 */
interface Props {
  sub?: string;
  class?: string;
}
const { sub, class: className = '' } = Astro.props;
---

<span class:list={['logo', className]}>
  <span class="logo__word">Spørretimen</span>
  {sub && <span class="logo__sub">{sub}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    gap: 0.42rem;
    color: var(--ink);
    line-height: 1;
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    /* Sperringen legges på høyre side av hvert tegn. Negativ margin til slutt
       gjør at ordet fortsatt står helt i venstrekanten av rutenettet. */
    letter-spacing: 0.2em;
    margin-right: -0.2em;
  }
  .logo__sub {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.19em;
    margin-right: -0.19em;
    color: var(--ink-faint);
  }

  @media (max-width: 600px) {
    .logo__word {
      font-size: 1.12rem;
      letter-spacing: 0.16em;
      margin-right: -0.16em;
    }
    .logo__sub {
      font-size: 0.54rem;
    }
  }
</style>
