---
/**
 * Spørretimen-ordmerke (plassholderlogo).
 *
 * Dette er en enkel, ren tekstlogo med et spørsmålstegn-motiv i aksentfargen.
 * Bytt ut med den offisielle logoen når den er klar – f.eks. ved å legge en
 * SVG i /public og erstatte innholdet under.
 */
interface Props {
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className = '' } = Astro.props;
---

<span class:list={['logo', { 'logo--compact': compact }, className]} aria-hidden="false">
  <svg class="logo__mark" viewBox="0 0 32 32" width="30" height="30" role="img" aria-label="Spørretimen">
    <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="1.6" opacity="0.28"></circle>
    <path
      d="M11.6 12.4c0-2.6 2-4.3 4.6-4.3 2.5 0 4.4 1.5 4.4 3.8 0 1.9-1.1 2.9-2.6 3.8-1.3.8-1.8 1.4-1.8 2.6v.6"
      fill="none"
      stroke="var(--accent)"
      stroke-width="2.1"
      stroke-linecap="round"
    ></path>
    <circle cx="16.2" cy="23.2" r="1.5" fill="var(--accent)"></circle>
  </svg>
  {!compact && <span class="logo__word">Spørretimen</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.4rem;
    letter-spacing: -0.015em;
    color: var(--ink);
    line-height: 1;
  }
  .logo__mark {
    flex: none;
    color: var(--ink);
  }
  .logo--compact {
    gap: 0;
  }
</style>
