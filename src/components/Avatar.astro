---
import { initials, placeholderColor } from '@/lib/utils';

/**
 * Gjesteportrett. Viser bilde hvis `src` er satt, ellers initialer på
 * en farget flate utledet av navnet.
 */
interface Props {
  src?: string;
  alt?: string;
  name: string;
  ratio?: string;
  /**
   * Fotokreditering, vist som «Foto: …» under bildet. Settes fra
   * `imageCredit` i frontmatter, og vises bare når kreditering faktisk er
   * påkrevd – egne bilder og bilder levert av gjesten trenger den ikke.
   */
  credit?: string;
  creditUrl?: string;
  class?: string;
}
const {
  src,
  alt,
  name,
  ratio = '1 / 1',
  credit,
  creditUrl,
  class: className = '',
} = Astro.props;
const [bg, fg] = placeholderColor(name);
---

<figure class:list={['avatar-figure', className]}>
  <div class="avatar" style={`--ratio:${ratio}`}>
    {
      src ? (
        <img src={src} alt={alt ?? `Portrett av ${name}`} loading="lazy" decoding="async" />
      ) : (
        <div class="avatar__ph" style={`--ph-bg:${bg}; --ph-fg:${fg}`} aria-hidden="true">
          <span>{initials(name)}</span>
        </div>
      )
    }
  </div>
  {
    credit && (
      <figcaption class="avatar__credit">
        Foto: {creditUrl ? <a href={creditUrl} target="_blank" rel="noopener">{credit}</a> : credit}
      </figcaption>
    )
  }
</figure>

<style>
  .avatar-figure {
    margin: 0;
  }
  .avatar__credit {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
  }
  .avatar__credit a {
    color: inherit;
  }
  .avatar {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--surface-2);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Samme hårfine innramming som omslagene, så lyse portretter får en klar
     kant mot kortet i stedet for å flyte ut i det. */
  .avatar::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(22, 19, 15, 0.09);
    pointer-events: none;
  }
  .avatar__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--ph-bg);
    color: var(--ph-fg);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 6vw, 3rem);
    letter-spacing: 0.04em;
  }
</style>
