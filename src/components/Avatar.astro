---
import { initials, placeholderColor } from '@/lib/utils';

/**
 * Gjesteportrett. Viser bilde hvis `src` er satt, ellers initialer på
 * en farget flate utledet av navnet.
 */
interface Props {
  src?: string;
  alt?: string;
  name: string;
  ratio?: string;
  class?: string;
}
const { src, alt, name, ratio = '1 / 1', class: className = '' } = Astro.props;
const [bg, fg] = placeholderColor(name);
---

<div class:list={['avatar', className]} style={`--ratio:${ratio}`}>
  {
    src ? (
      <img src={src} alt={alt ?? `Portrett av ${name}`} loading="lazy" decoding="async" />
    ) : (
      <div class="avatar__ph" style={`--ph-bg:${bg}; --ph-fg:${fg}`} aria-hidden="true">
        <span>{initials(name)}</span>
      </div>
    )
  }
</div>

<style>
  .avatar {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--surface-2);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(140deg, var(--ph-bg), color-mix(in srgb, var(--ph-bg) 55%, #fff));
    color: var(--ph-fg);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 6vw, 3rem);
    letter-spacing: 0.02em;
  }
</style>
