---
/**
 * Enkle strekikoner til temakortene. Ett per hovedtema, satt i `icon` i
 * src/data/topics.ts. Strektegnet med vilje – flate ikoner i farge ville
 * trukket oppmerksomheten fra typografien.
 */
interface Props {
  name: string;
  size?: number;
}
const { name, size = 22 } = Astro.props;

const paths: Record<string, string> = {
  coins: 'M4 8.5c0-1.7 3.1-3 7-3s7 1.3 7 3-3.1 3-7 3-7-1.3-7-3zm0 0v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7M20 12v5.5c0 1.6-2.5 2.9-6 3',
  chip: 'M8 8h8v8H8zM5.5 5.5h13v13h-13zM10 3v2.5M14 3v2.5M10 18.5V21M14 18.5V21M3 10h2.5M3 14h2.5M18.5 10H21M18.5 14H21',
  head: 'M15.5 20.5v-2.6c0-.7.4-1.3 1-1.6 1.6-.9 2.5-2.6 2.5-4.6a7 7 0 0 0-14 0c0 1.4.4 2.5 1 3.4l-1 2.4h2.3v3M12 8.5a2 2 0 1 0 0 4',
  book: 'M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5zM19 18v3H6.5A1.5 1.5 0 0 1 5 19.5',
  briefcase: 'M3.5 8.5h17v10h-17zM9 8.5V6a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 6v2.5M3.5 13h17',
  pulse: 'M3 12.5h3.5L9 7l3 10 2.5-5.5H21',
  globe: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zM3.5 12h17M12 3.5c2.2 2.3 3.3 5.1 3.3 8.5S14.2 18.2 12 20.5c-2.2-2.3-3.3-5.1-3.3-8.5S9.8 5.8 12 3.5z',
  note: 'M9 17.5V6.2l9-1.7v11M9 17.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0zM18 15.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z',
  mountain: 'M3 19h18L14 6l-3.5 6.5L8.5 10z',
};
const d = paths[name] ?? paths.book;
---

<svg
  class="topic-icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path
    d={d}
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>

<style>
  .topic-icon {
    flex: none;
  }
</style>
